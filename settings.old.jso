--[[
	╔══════════════════════════════════════════════════════════════════════╗
	║        CFrame Lerp Animation Editor  •  Executor Edition  v3.1      ║
	║  Direct Motor6D.C0 lerping  •  NO AnimationTracks / KeyframeSeq     ║
	╚══════════════════════════════════════════════════════════════════════╝

	v3.1 CHANGES
	  - Spin is now truly infinite accumulator-based (not cos oscillation)
	    Applied via a running CFrame so lerp stays smooth and it never resets
	  - Axis lock actually works: reads Part0's world CFrame, computes the
	    inverse rotation for the locked axes, and applies a counter-CFrame
	    each frame — so locked axes stay world-aligned regardless of how the
	    root moves. Multiple axes can be locked simultaneously.
	  - Export has zero spaces (compact paste-ready format)
	  - Sub-axis layout order fixed so bodies don't overlap in scroll frame
--]]

-- ═══════════════════════════════════════════════════════════════════════
--  SERVICES
-- ═══════════════════════════════════════════════════════════════════════
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local HttpService      = game:GetService("HttpService")
local CoreGui          = game:GetService("CoreGui")
local Camera           = workspace.CurrentCamera

local player = Players.LocalPlayer
local char   = player.Character or player.CharacterAdded:Wait()

local function waitForRig(c)
	local t0 = tick()
	while not (c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso"))
		and tick()-t0 < 5 do task.wait(0.05) end
	task.wait(0.2)
end
waitForRig(char)

local function disableAnimate(c)
	local anim = c:FindFirstChild("Animate")
	if anim and anim:IsA("LocalScript") then anim.Disabled = true end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _,t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end
		end
	end
end
disableAnimate(char)

-- ═══════════════════════════════════════════════════════════════════════
--  SCREEN SCALING
-- ═══════════════════════════════════════════════════════════════════════
local BASE_W,BASE_H = 1920,1080
local function calcScale()
	local vp = Camera.ViewportSize
	return math.min(vp.X/BASE_W, vp.Y/BASE_H)
end
local S = calcScale()
local function px(n)   return math.max(1, math.round(n*S)) end
local function ud(s,o) return UDim.new(s, px(o)) end
local FS = { tiny=math.max(8,px(10)), sm=math.max(9,px(11)), md=math.max(10,px(13)) }
Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() S=calcScale() end)

-- ═══════════════════════════════════════════════════════════════════════
--  MATH
-- ═══════════════════════════════════════════════════════════════════════
local cf      = CFrame.new
local angles  = CFrame.Angles
local function cfMul(a,b) return a*b end
local function Lerp(a,b,t) return a:Lerp(b,t) end
local pi      = math.pi
local sin     = math.sin
local fmt     = string.format
local TWO_PI  = pi*2

-- ═══════════════════════════════════════════════════════════════════════
--  R6 DEFAULTS
-- ═══════════════════════════════════════════════════════════════════════
local R6_DEF = {
	RootJoint     = {pos=cf(0,0,0),     rot=angles(-pi/2,0,pi)},
	Neck          = {pos=cf(0,1,0),     rot=angles(-pi/2,0,pi)},
	RightShoulder = {pos=cf(1,0.5,0),   rot=angles(0,pi/2,0)  },
	LeftShoulder  = {pos=cf(-1,0.5,0),  rot=angles(0,-pi/2,0) },
	RightHip      = {pos=cf(0.5,-1,0),  rot=angles(0,pi/2,0)  },
	LeftHip       = {pos=cf(-0.5,-1,0), rot=angles(0,-pi/2,0) },
}
local DISPLAY_NAMES = {
	RootJoint="Torso (RootJoint)",       Neck="Head (Neck)",
	RightShoulder="R Arm (RightShoulder)", LeftShoulder="L Arm (LeftShoulder)",
	RightHip="R Leg (RightHip)",          LeftHip="L Leg (LeftHip)",
}
local MIRROR_MAP = {
	RightShoulder="LeftShoulder", LeftShoulder="RightShoulder",
	RightHip="LeftHip",          LeftHip="RightHip",
}
local R6_ORDER = {"RootJoint","Neck","RightShoulder","LeftShoulder","RightHip","LeftHip"}

-- ═══════════════════════════════════════════════════════════════════════
--  JOINT DATA
-- ═══════════════════════════════════════════════════════════════════════
local function makeSineAxis()
	return {amp=0,speed=1,offset=0,reverse=false}
end
local function makeSpinAxis()
	-- _angle accumulates forever; applied as a running CFrame offset
	return {enabled=false,speed=1,reverse=false,_angle=0}
end

local function makeJointData(motor)
	local name = motor.Name
	local def  = R6_DEF[name]
	local bpx,bpy,bpz,brx,bry,brz
	if def then
		bpx,bpy,bpz = def.pos.X,def.pos.Y,def.pos.Z
		brx,bry,brz = def.rot:ToEulerAnglesXYZ()
	else
		local c0 = motor.C0 or CFrame.new()
		bpx,bpy,bpz = c0.X,c0.Y,c0.Z
		brx,bry,brz = c0:ToEulerAnglesXYZ()
	end
	return {
		name=name, motor=motor, enabled=true,
		posX=bpx,posY=bpy,posZ=bpz,
		rotX=brx,rotY=bry,rotZ=brz,
		sineX=makeSineAxis(),sineY=makeSineAxis(),sineZ=makeSineAxis(),
		sinePosX=makeSineAxis(),sinePosY=makeSineAxis(),sinePosZ=makeSineAxis(),
		spinX=makeSpinAxis(),spinY=makeSpinAxis(),spinZ=makeSpinAxis(),
		lockX=false,lockY=false,lockZ=false,
	}
end

-- ═══════════════════════════════════════════════════════════════════════
--  DETECT MOTORS + ACCESSORIES
-- ═══════════════════════════════════════════════════════════════════════
local allJointData = {}
local jointOrder   = {}

local function getHandleWeld(acc)
	local handle = acc:FindFirstChild("Handle")
	if not handle then return nil end
	for _,v in ipairs(handle:GetChildren()) do
		if v:IsA("Motor6D") or v:IsA("Weld") then return v end
	end
	for _,v in ipairs(handle:GetChildren()) do
		if v:IsA("WeldConstraint") then return v end
	end
end

local function detectAllMotors(c)
	allJointData={}; jointOrder={}
	local seen={}

	local bodyMotors={}
	for _,v in ipairs(c:GetDescendants()) do
		if v:IsA("Motor6D") then
			if not bodyMotors[v.Name] then bodyMotors[v.Name]=v end
		end
	end

	for _,name in ipairs(R6_ORDER) do
		if bodyMotors[name] and not seen[name] then
			allJointData[name]=makeJointData(bodyMotors[name])
			table.insert(jointOrder,name)
			seen[name]=true
			bodyMotors[name]=nil
		end
	end

	local extras={}
	for k in pairs(bodyMotors) do table.insert(extras,k) end
	table.sort(extras)
	for _,key in ipairs(extras) do
		if not seen[key] then
			allJointData[key]=makeJointData(bodyMotors[key])
			table.insert(jointOrder,key)
			seen[key]=true
		end
	end

	-- Accessories: direct Accessory children of character
	for _,child in ipairs(c:GetChildren()) do
		if child:IsA("Accessory") then
			local weld=getHandleWeld(child)
			if weld and not (weld:IsA("WeldConstraint")) then
				local key=child.Name
				local base=key; local n=2
				while seen[key] do key=base.."_"..n; n=n+1 end
				local data=makeJointData(weld)
				data.name=key
				data.isAccessory=true
				data.weld=weld
				allJointData[key]=data
				table.insert(jointOrder,key)
				seen[key]=true
			end
		end
	end
end

detectAllMotors(char)

-- ═══════════════════════════════════════════════════════════════════════
--  UNDO / REDO
-- ═══════════════════════════════════════════════════════════════════════
local undoStack,redoStack={},{}

local function deepCopy(t)
	if type(t)~="table" then return t end
	local c={}
	for k,v in pairs(t) do
		if k~="motor" and k~="weld" then c[k]=deepCopy(v) else c[k]=v end
	end
	return c
end

local function snapshotAll()
	local s={}
	for n,d in pairs(allJointData) do s[n]=deepCopy(d) end
	return s
end

local function pushUndo()
	table.insert(undoStack,snapshotAll())
	if #undoStack>50 then table.remove(undoStack,1) end
	redoStack={}
end

local function restoreSnapshot(snap)
	for name,saved in pairs(snap) do
		if allJointData[name] then
			saved.motor=allJointData[name].motor
			saved.weld=allJointData[name].weld
			allJointData[name]=saved
		end
	end
end

local function doUndo()
	if #undoStack==0 then return end
	table.insert(redoStack,snapshotAll())
	restoreSnapshot(table.remove(undoStack))
end
local function doRedo()
	if #redoStack==0 then return end
	table.insert(undoStack,snapshotAll())
	restoreSnapshot(table.remove(redoStack))
end

local clipboard=nil

-- ═══════════════════════════════════════════════════════════════════════
--  CODE EXPORT  (zero spaces, compact, paste-ready)
-- ═══════════════════════════════════════════════════════════════════════
local function fmtN(n) return fmt("%.16g",n) end

local function sineAxisExpr(base,sa)
	if sa.amp==0 then return fmtN(base) end
	local realAmp=sa.reverse and -sa.amp or sa.amp
	local sign=realAmp>=0 and "+" or "-"
	local offStr=sa.offset~=0 and ("+"..fmtN(sa.offset)) or ""
	return fmtN(base)..sign..fmtN(math.abs(realAmp)).."*sin(sine*"..fmtN(sa.speed)..offStr..")"
end

local function buildCf(d)
	local function ax(base,sa)
		if sa.amp==0 then return fmtN(base) end
		local r=sa.reverse and -sa.amp or sa.amp
		local sign=r>=0 and "+" or "-"
		local off=sa.offset~=0 and ("+"..fmtN(sa.offset)) or ""
		return fmtN(base)..sign..fmtN(math.abs(r)).."*sin(sine*"..fmtN(sa.speed)..off..")"
	end
	return "cf("..ax(d.posX,d.sinePosX)..","..ax(d.posY,d.sinePosY)..","..ax(d.posZ,d.sinePosZ)..")"
end

local function buildAngles(d)
	-- Spin is an accumulator at runtime; exported as a large sin expression
	-- approximation note in the export comment. For export we just output
	-- the sine part (spin can't be truly exported as it's stateful).
	local function rot(base,sa)
		return sineAxisExpr(base,sa)
	end
	return "angles("..rot(d.rotX,d.sineX)..","..rot(d.rotY,d.sineY)..","..rot(d.rotZ,d.sineZ)..")"
end

local function exportLine(varName,d)
	return varName..".C0=Lerp("..varName..".C0,cfMul("..buildCf(d)..","..buildAngles(d).."),deltaTime)"
end

local function generateCode()
	local lines={}
	for _,name in ipairs(jointOrder) do
		local d=allJointData[name]
		if d and d.enabled then table.insert(lines,exportLine(name,d)) end
	end
	return table.concat(lines,"\n")
end

-- ═══════════════════════════════════════════════════════════════════════
--  AXIS LOCK  (world-space counter-rotation)
--
--  How it works:
--    The Motor6D transforms a part relative to its Part0.
--    C0 is the offset from Part0's CFrame to the joint pivot.
--    C1 is the offset from Part1's CFrame to the joint pivot.
--
--    Part1.CFrame = Part0.CFrame * C0 * C1:Inverse()
--
--    To lock an axis in WORLD space, we read Part0's world rotation,
--    extract the rotation we DON'T want (the locked axes), and bake a
--    counter-rotation into C0 that cancels it out.
--
--    Specifically: if the user locks X, we want Part1's world X-rotation
--    to remain at whatever it was when locked. We compute the delta
--    between the current Part0 rotation and the "locked" reference
--    rotation, then subtract that delta from C0's rotation on that axis.
-- ═══════════════════════════════════════════════════════════════════════

-- Store the world-space rotation reference when a lock is first enabled.
-- Key: jointName.."_refCF"  → CFrame (world)
local lockRef = {}

local function getMotorPart0(motor)
	if not motor then return nil end
	if motor:IsA("Motor6D") then return motor.Part0
	elseif motor:IsA("Weld") then return motor.Part0
	end
	return nil
end

-- ═══════════════════════════════════════════════════════════════════════
--  RUNTIME ANIMATION
-- ═══════════════════════════════════════════════════════════════════════
local sine  = 0
local ALPHA = 0.2

local function evalSineAxis(base,sa)
	if sa.amp==0 then return base end
	local dir=sa.reverse and -1 or 1
	return base + sin(sine*sa.speed+sa.offset)*sa.amp*dir
end

local function applyJoint(d,dt)
	local motor = d.isAccessory and d.weld or d.motor
	if not motor or not motor.Parent or not d.enabled then return end

	-- Accumulate spin angles (unbounded, per-axis)
	for _,ax in ipairs({"X","Y","Z"}) do
		local sp=d["spin"..ax]
		if sp.enabled then
			local dir=sp.reverse and -1 or 1
			sp._angle = sp._angle + sp.speed*dt*dir
		end
	end

	-- Build base target position + rotation
	local px_=evalSineAxis(d.posX,d.sinePosX)
	local py_=evalSineAxis(d.posY,d.sinePosY)
	local pz_=evalSineAxis(d.posZ,d.sinePosZ)

	local rx=evalSineAxis(d.rotX,d.sineX)
	local ry=evalSineAxis(d.rotY,d.sineY)
	local rz=evalSineAxis(d.rotZ,d.sineZ)

	-- Add spin accumulators
	rx=rx+d.spinX._angle
	ry=ry+d.spinY._angle
	rz=rz+d.spinZ._angle

	local target = cfMul(cf(px_,py_,pz_), angles(rx,ry,rz))

	-- ── AXIS LOCK ────────────────────────────────────────────────────
	-- If any axis is locked, we apply a counter-rotation in C0 so that
	-- the limb's world rotation on those axes stays at the locked reference.
	if d.lockX or d.lockY or d.lockZ then
		local part0=getMotorPart0(motor)
		if part0 then
			local name=d.name
			-- Capture reference when lock is first toggled on
			if not lockRef[name] then
				lockRef[name]=part0.CFrame
			end

			-- Current Part0 world CFrame (rotation only, no position)
			local p0Rot = part0.CFrame - part0.CFrame.Position

			-- Reference rotation (when lock was set)
			local refRot = lockRef[name] - lockRef[name].Position

			-- Delta = how much Part0 has rotated since lock was set
			-- We want to UNDO this delta on the locked axes.
			local delta = refRot * p0Rot:Inverse()  -- world-space counter

			-- Extract Euler angles of the delta
			local dRX,dRY,dRZ = delta:ToEulerAnglesXYZ()

			-- Apply opposing rotation only on locked axes
			local cX = d.lockX and dRX or 0
			local cY = d.lockY and dRY or 0
			local cZ = d.lockZ and dRZ or 0

			-- Bake counter-rotation into the target
			local counter = angles(cX,cY,cZ)
			target = cfMul(target, counter)
		end
	else
		-- Clear reference when not locked
		lockRef[d.name]=nil
	end

	motor.C0 = Lerp(motor.C0, target, ALPHA)
end

local rtConn
local function startRuntime()
	if rtConn then rtConn:Disconnect() end
	rtConn=RunService.RenderStepped:Connect(function(dt)
		sine=sine+dt*60*0.016
		for _,name in ipairs(jointOrder) do
			local d=allJointData[name]
			if d then applyJoint(d,dt) end
		end
	end)
end
startRuntime()

