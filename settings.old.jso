--[[
	╔══════════════════════════════════════════════════════════════════════╗
	║        CFrame Lerp Animation Editor  •  Executor Edition  v3.1      ║
	║  Direct Motor6D.C0 lerping  •  NO AnimationTracks / KeyframeSeq     ║
	╚══════════════════════════════════════════════════════════════════════╝

	v3.1 CHANGES
	  - Per-axis sine:  X, Y, Z each have their own Amp / Speed / Offset / Reverse
	  - Per-axis spin:  X, Y, Z each have their own Speed / Reverse / Enable
	    Uses continuous angular motion; speed is scaled in the runtime
	  - Accessories detected as direct Accessory children of the character,
	    reading the Handle's Weld/Motor6D for the C0 offset
	  - Typed values still bypass slider limits
	  - Spin no longer resets / glitches
--]]

-- ═══════════════════════════════════════════════════════════════════════
--  SERVICES
-- ═══════════════════════════════════════════════════════════════════════
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local HttpService      = game:GetService("HttpService")
local CoreGui          = game:GetService("CoreGui")
local Camera           = workspace.CurrentCamera

local player = Players.LocalPlayer

-- ═══════════════════════════════════════════════════════════════════════
--  WAIT FOR CHARACTER
-- ═══════════════════════════════════════════════════════════════════════
local char = player.Character or player.CharacterAdded:Wait()

local function waitForRig(c)
	local t0 = tick()
	while not (c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso"))
		and tick()-t0 < 5 do task.wait(0.05) end
	task.wait(0.2)
end
waitForRig(char)

-- ═══════════════════════════════════════════════════════════════════════
--  DISABLE ROBLOX DEFAULT ANIMATE SCRIPT
-- ═══════════════════════════════════════════════════════════════════════
local function disableAnimate(c)
	local anim = c:FindFirstChild("Animate")
	if anim and anim:IsA("LocalScript") then anim.Disabled = true end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end
		end
	end
end
disableAnimate(char)

-- ═══════════════════════════════════════════════════════════════════════
--  SCREEN SCALING
-- ═══════════════════════════════════════════════════════════════════════
local BASE_W, BASE_H = 1920, 1080
local function calcScale()
	local vp = Camera.ViewportSize
	return math.min(vp.X/BASE_W, vp.Y/BASE_H)
end
local S = calcScale()
local function px(n)   return math.max(1, math.round(n*S)) end
local function ud(s,o) return UDim.new(s, px(o)) end
local FS = { tiny=math.max(8,px(10)), sm=math.max(9,px(11)), md=math.max(10,px(13)) }
Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function() S=calcScale() end)

-- ═══════════════════════════════════════════════════════════════════════
--  MATH
-- ═══════════════════════════════════════════════════════════════════════
local cf     = CFrame.new
local angles = CFrame.Angles
local function cfMul(a,b) return a*b end
local function Lerp(a,b,t) return a:Lerp(b,t) end
local pi     = math.pi
local sin    = math.sin
local fmt    = string.format
local TWO_PI = pi*2

-- ═══════════════════════════════════════════════════════════════════════
--  DISPLAY NAMES
-- ═══════════════════════════════════════════════════════════════════════
local DISPLAY_NAMES = {
	RootJoint="Torso (RootJoint)", Neck="Head (Neck)",
	RightShoulder="R Arm (RightShoulder)", LeftShoulder="L Arm (LeftShoulder)",
	RightHip="R Leg (RightHip)", LeftHip="L Leg (LeftHip)",
}
local MIRROR_MAP = {
	RightShoulder="LeftShoulder", LeftShoulder="RightShoulder",
	RightHip="LeftHip",          LeftHip="RightHip",
}
local R6_ORDER = {"RootJoint","Neck","RightShoulder","LeftShoulder","RightHip","LeftHip"}

-- ═══════════════════════════════════════════════════════════════════════
--  JOINT DATA (per-axis sine motion and continuous spin)
-- ═══════════════════════════════════════════════════════════════════════
--[[
	Sine per axis: amp * sin(phase * speed + offset), in radians.
	Position sine uses studs; rotation sine uses radians.
	Spin is continuous: phase * speed * 0.05, in radians.
]]

local function makeSineAxis()
	return { amp=0, speed=1, offset=0, reverse=false }
end
local function makeSpinAxis()
	return { enabled=false, speed=1, reverse=false }
end

local function makeJointData(motor, key, restC0, isAccessory)
	local name = key or motor.Name
	local c0 = restC0 or (motor and motor.C0) or CFrame.new()
	local bpx,bpy,bpz = c0.X, c0.Y, c0.Z
	local brx,bry,brz = c0:ToEulerAnglesXYZ()

	return {
		name=name, motor=motor, enabled=true,
		restC0=c0, isAccessory=isAccessory or false,
		-- base transform
		posX=bpx, posY=bpy, posZ=bpz,
		rotX=brx, rotY=bry, rotZ=brz,
		-- per-axis rotation sine
		sineX=makeSineAxis(), sineY=makeSineAxis(), sineZ=makeSineAxis(),
		-- per-axis position sine
		sinePosX=makeSineAxis(), sinePosY=makeSineAxis(), sinePosZ=makeSineAxis(),
		-- continuous spin, internally scaled by 0.05
		spinX=makeSpinAxis(), spinY=makeSpinAxis(), spinZ=makeSpinAxis(),
		-- axis lock
		lockX=false, lockY=false, lockZ=false,
		-- PART SELF ROTATION
		-- Applied after normal position/rotation so the part rotates around itself.
		baseRotX = 0,
		baseRotY = 0,
		baseRotZ = 0,
		baseRotationFirst = false,

		baseSineX = makeSineAxis(),
		baseSineY = makeSineAxis(),
		baseSineZ = makeSineAxis(),

		baseSpinX = makeSpinAxis(),
		baseSpinY = makeSpinAxis(),
		baseSpinZ = makeSpinAxis(),

		selfPivotX = 0,
		selfPivotY = 0,
		selfPivotZ = 0,
		restSelfPivotX = 0,
		restSelfPivotY = 0,
		restSelfPivotZ = 0,
	}
end

local function resetJointData(d)
	local motor = d.isAccessory and d.weld or d.motor
	if not motor or not d.restC0 then return end
	local fresh = makeJointData(motor, d.name, d.restC0, d.isAccessory)
	fresh.weld = d.weld
	fresh.accessoryName = d.accessoryName
	fresh.restSelfPivotX, fresh.restSelfPivotY, fresh.restSelfPivotZ = d.restSelfPivotX or 0, d.restSelfPivotY or 0, d.restSelfPivotZ or 0
	fresh.selfPivotX, fresh.selfPivotY, fresh.selfPivotZ = fresh.restSelfPivotX, fresh.restSelfPivotY, fresh.restSelfPivotZ
	for k, v in pairs(fresh) do d[k] = v end
end

-- ═══════════════════════════════════════════════════════════════════════
--  DETECT ALL MOTORS + ACCESSORIES
--
--  Body joints:   Motor6D descendants anywhere in character
--  Accessories:   Direct Accessory children of character
--                 → their Handle part → Weld / Motor6D on Handle
-- ═══════════════════════════════════════════════════════════════════════
local allJointData = {}
local jointOrder   = {}

local function getHandleJoint(accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not handle then return nil end
	for _, v in ipairs(handle:GetChildren()) do
		if v:IsA("Motor6D") or v:IsA("Weld") then
			return v
		end
	end
	-- WeldConstraint has no editable C0, so it is deliberately not exposed
	-- as an animatable joint.
	return nil
end

local function getAccessorySelfPivot(accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not handle then return 0, 0, 0 end
	local sm = handle:FindFirstChildOfClass("SpecialMesh")
	if sm then
		local off = sm.Offset
		return off.X, off.Y, off.Z
	end
	return 0, 0, 0
end

local function detectAllMotors(c)
	allJointData = {}
	jointOrder   = {}
	local seen = {}
	local bodyMotors = {}

	local function uniqueKey(baseKey)
		local key, suffix = baseKey, 2
		while seen[key] do
			key = baseKey .. "_" .. suffix
			suffix = suffix + 1
		end
		seen[key] = true
		return key
	end

	local function isInsideAccessory(instance)
		local parent = instance.Parent
		while parent and parent ~= c do
			if parent:IsA("Accessory") then return true end
			parent = parent.Parent
		end
		return false
	end

	for _, v in ipairs(c:GetDescendants()) do
		if v:IsA("Motor6D") and not isInsideAccessory(v) then
			table.insert(bodyMotors, v)
		end
	end
	table.sort(bodyMotors, function(a, b)
		local ai, bi = table.find(R6_ORDER, a.Name), table.find(R6_ORDER, b.Name)
		if ai and bi then return ai < bi end
		if ai then return true end
		if bi then return false end
		return a.Name < b.Name
	end)

	for _, motor in ipairs(bodyMotors) do
		local key = uniqueKey(motor.Name)
		allJointData[key] = makeJointData(motor, key, motor.C0, false)
		table.insert(jointOrder, key)
	end

	for _, child in ipairs(c:GetChildren()) do
		if child:IsA("Accessory") then
			local weld = getHandleJoint(child)
			if weld then
				local key = uniqueKey(child.Name)
				local data = makeJointData(weld, key, weld.C0, true)
				data.accessoryName = child.Name
				data.weld = weld
				data.selfPivotX, data.selfPivotY, data.selfPivotZ = getAccessorySelfPivot(child)
				data.restSelfPivotX, data.restSelfPivotY, data.restSelfPivotZ = data.selfPivotX, data.selfPivotY, data.selfPivotZ
				allJointData[key] = data
				table.insert(jointOrder, key)
			end
		end
	end
end

detectAllMotors(char)

-- ═══════════════════════════════════════════════════════════════════════
--  UNDO / REDO
-- ═══════════════════════════════════════════════════════════════════════
local undoStack, redoStack = {}, {}
local rebuildJointUI
local refreshJointSections
local resetAllJointData

local function deepCopy(t)
	if type(t)~="table" then return t end
	local c={}
	for k,v in pairs(t) do
		if k~="motor" and k~="weld" then c[k]=deepCopy(v)
		else c[k]=v end
	end
	return c
end
local function snapshotAll()
	local s={}; for n,d in pairs(allJointData) do s[n]=deepCopy(d) end; return s
end
local function pushUndo()
	table.insert(undoStack,snapshotAll())
	if #undoStack>50 then table.remove(undoStack,1) end
	redoStack={}
end
local function restoreSnapshot(snap)
	for name,saved in pairs(snap) do
		local live = allJointData[name]
		if live then
			local restored = deepCopy(saved)
			restored.motor = live.motor
			restored.weld = live.weld or (restored.isAccessory and live.motor or nil)
			allJointData[name] = restored
		end
	end
	if rebuildJointUI then rebuildJointUI() end
end
local function doUndo()
	if #undoStack==0 then return end
	table.insert(redoStack,snapshotAll()); restoreSnapshot(table.remove(undoStack))
end
local function doRedo()
	if #redoStack==0 then return end
	table.insert(undoStack,snapshotAll()); restoreSnapshot(table.remove(redoStack))
end
local clipboard=nil

-- ═══════════════════════════════════════════════════════════════════════
--  CODE EXPORT
-- ═══════════════════════════════════════════════════════════════════════
local function fmtN(n) return fmt("%.16g",n) end

local function sineAxisExpr(base, sa)
	if sa.amp == 0 then return fmtN(base) end
	local realAmp = sa.reverse and -sa.amp or sa.amp
	local sign = realAmp >= 0 and "+" or "-"
	local offset = sa.offset ~= 0 and fmt("+%s", fmtN(sa.offset)) or ""
	return fmt("%s%s%s*sin(sine*%s%s)", fmtN(base), sign, fmtN(math.abs(realAmp)), fmtN(sa.speed), offset)
end

local function spinAxisExpr(spinA)
	if not spinA.enabled then return nil end
	local direction = spinA.reverse and "-" or "+"
	return fmt("%smath.fmod(sine*%s,math.pi*2)", direction, fmtN(spinA.speed * 0.05))
end

local function buildCf(d)
	local function axisExpr(base, sineData, locked)
		if locked or sineData.amp == 0 then return fmtN(base) end
		local amp = sineData.reverse and -sineData.amp or sineData.amp
		local sign = amp >= 0 and "+" or "-"
		local offset = sineData.offset ~= 0 and fmt("+%s", fmtN(sineData.offset)) or ""
		return fmt("%s%s%s*sin(sine*%s%s)", fmtN(base), sign, fmtN(math.abs(amp)), fmtN(sineData.speed), offset)
	end
	return fmt("cf(%s,%s,%s)",
		axisExpr(d.posX, d.sinePosX, d.lockX),
		axisExpr(d.posY, d.sinePosY, d.lockY),
		axisExpr(d.posZ, d.sinePosZ, d.lockZ))
end

local function buildAngleExpr(base, sineData, spinData, locked)
	if locked then return fmtN(base) end
	local expression = sineAxisExpr(base, sineData)
	local spin = spinAxisExpr(spinData)
	return spin and ("(" .. expression .. spin .. ")") or expression
end

local function buildAngles(d)
	return fmt("angles(%s,%s,%s)",
		buildAngleExpr(d.rotX, d.sineX, d.spinX, d.lockX),
		buildAngleExpr(d.rotY, d.sineY, d.spinY, d.lockY),
		buildAngleExpr(d.rotZ, d.sineZ, d.spinZ, d.lockZ))
end

local function buildSelfAngles(d)
	return fmt("angles(%s,%s,%s)",
		buildAngleExpr(d.baseRotX or 0, d.baseSineX, d.baseSpinX, d.lockX),
		buildAngleExpr(d.baseRotY or 0, d.baseSineY, d.baseSpinY, d.lockY),
		buildAngleExpr(d.baseRotZ or 0, d.baseSineZ, d.baseSpinZ, d.lockZ))
end

local function buildSelfPivot(d)
	return fmt("cf(%s,%s,%s)", fmtN(d.selfPivotX or 0), fmtN(d.selfPivotY or 0), fmtN(d.selfPivotZ or 0))
end

local function buildInverseSelfPivot(d)
	return fmt("cf(%s,%s,%s)", fmtN(-(d.selfPivotX or 0)), fmtN(-(d.selfPivotY or 0)), fmtN(-(d.selfPivotZ or 0)))
end

local function exportLine(varName, d)
	local normalCF = fmt("cfMul(%s,%s)", buildCf(d), buildAngles(d))
	local selfCF = buildSelfAngles(d)
	if d.isAccessory then
		selfCF = fmt("cfMul(%s,cfMul(%s,%s))", buildSelfPivot(d), selfCF, buildInverseSelfPivot(d))
	end
	local target = d.baseRotationFirst
		and fmt("cfMul(%s,%s)", selfCF, normalCF)
		or fmt("cfMul(%s,%s)", normalCF, selfCF)
	return fmt("%s.C0=Lerp(%s.C0,%s,1-(1-0.2)^(deltaTime*60))", varName, varName, target)
end

local function generateCode()
	local lines = {}
	for _, name in ipairs(jointOrder) do
		local d = allJointData[name]
		if d and d.enabled then table.insert(lines, exportLine(name, d)) end
	end
	return table.concat(lines, "\n")
end

-- ═══════════════════════════════════════════════════════════════════════
--  RUNTIME ANIMATION
-- ═══════════════════════════════════════════════════════════════════════
local sine = 0
local ALPHA_AT_60_FPS = 0.2

local function evalSineAxis(base, sa)
	if sa.amp==0 then return base end
	local dir = sa.reverse and -1 or 1
	return base + sin(sine*sa.speed + sa.offset) * sa.amp * dir
end

local function evalSpinAxis(spA)
	if not spA.enabled then
		return 0
	end

	local dir = spA.reverse and -1 or 1

	-- scaled so entering numbers manually
	-- doesn't create impossible speeds
	local speed = spA.speed * 0.05

	return math.fmod(sine * speed, TWO_PI) * dir
end

local function applyJoint(d, dt)
	local motor = d.isAccessory and d.weld or d.motor
	if not motor or not motor.Parent then return end
	if not motor:IsA("Motor6D") and not motor:IsA("Weld") then return end
	local alpha = 1 - (1 - ALPHA_AT_60_FPS) ^ (math.max(dt, 0) * 60)
	if not d.enabled then
		motor.C0 = Lerp(motor.C0, d.restC0, alpha)
		return
	end

	local px_ = d.lockX and d.posX or evalSineAxis(d.posX, d.sinePosX)
	local py_ = d.lockY and d.posY or evalSineAxis(d.posY, d.sinePosY)
	local pz_ = d.lockZ and d.posZ or evalSineAxis(d.posZ, d.sinePosZ)
	local rx = d.lockX and d.rotX or (evalSineAxis(d.rotX, d.sineX) + evalSpinAxis(d.spinX))
	local ry = d.lockY and d.rotY or (evalSineAxis(d.rotY, d.sineY) + evalSpinAxis(d.spinY))
	local rz = d.lockZ and d.rotZ or (evalSineAxis(d.rotZ, d.sineZ) + evalSpinAxis(d.spinZ))
	local baseRx = d.lockX and (d.baseRotX or 0) or (evalSineAxis(d.baseRotX or 0, d.baseSineX) + evalSpinAxis(d.baseSpinX))
	local baseRy = d.lockY and (d.baseRotY or 0) or (evalSineAxis(d.baseRotY or 0, d.baseSineY) + evalSpinAxis(d.baseSpinY))
	local baseRz = d.lockZ and (d.baseRotZ or 0) or (evalSineAxis(d.baseRotZ or 0, d.baseSineZ) + evalSpinAxis(d.baseSpinZ))

	local baseCF = angles(baseRx, baseRy, baseRz)
	local animCF = cfMul(cf(px_, py_, pz_), angles(rx, ry, rz))
	local selfCF = baseCF
	if d.isAccessory then
		local pivotCF = cf(d.selfPivotX or 0, d.selfPivotY or 0, d.selfPivotZ or 0)
		local invPivotCF = cf(-(d.selfPivotX or 0), -(d.selfPivotY or 0), -(d.selfPivotZ or 0))
		selfCF = cfMul(pivotCF, cfMul(baseCF, invPivotCF))
	end

	local targetCF = d.baseRotationFirst and cfMul(selfCF, animCF) or cfMul(animCF, selfCF)
	motor.C0 = Lerp(motor.C0, targetCF, alpha)
end

local rtConn
local function startRuntime()
	if rtConn then rtConn:Disconnect() end
	rtConn = RunService.RenderStepped:Connect(function(dt)
		sine = sine + dt
		for _, name in ipairs(jointOrder) do
			local d = allJointData[name]
			if d then applyJoint(d, dt) end
		end
	end)
end
startRuntime()

