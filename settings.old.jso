	Text="-- initialising…",PlaceholderText="",TextColor3=C.code,Font=Enum.Font.Code,TextSize=FS.tiny,
	TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
