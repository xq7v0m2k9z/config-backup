--  PRESETS
-- ═══════════════════════════════════════════════════════════════════════
resetAllJointData=function()
	for _,name in ipairs(jointOrder) do
		local d=allJointData[name]
		if d then resetJointData(d) end
	end
end

local function findJointData(...)
	for _,name in ipairs({...}) do
		if allJointData[name] then return allJointData[name] end
	end
	return nil
end

local PRESETS={
	{name="Idle",apply=function()
		pushUndo()
		resetAllJointData()
		local rj=findJointData("RootJoint","Root","Waist"); local ne=findJointData("Neck")
		local rs=findJointData("RightShoulder"); local ls=findJointData("LeftShoulder")
		if rj then rj.sinePosY.amp=0.06; rj.sinePosY.speed=1.6 end
		if ne then ne.sineX.amp=0.08; ne.sineX.speed=1.6 end
		if rs then rs.sineX.amp=0.06; rs.sineX.speed=1.6 end
		if ls then ls.sineX.amp=0.06; ls.sineX.speed=1.6 end
	end},
	{name="Walk",apply=function()
		pushUndo()
		resetAllJointData()
		local rh=findJointData("RightHip"); local lh=findJointData("LeftHip")
		local rs=findJointData("RightShoulder"); local ls=findJointData("LeftShoulder")
		local rj=findJointData("RootJoint","Root","Waist"); local ne=findJointData("Neck")
		if rh then rh.sineX.amp=0.45; rh.sineX.speed=7.5 end
		if lh then lh.sineX.amp=0.45; lh.sineX.speed=7.5; lh.sineX.reverse=true end
		if rs then rs.sineX.amp=0.35; rs.sineX.speed=7.5; rs.sineX.reverse=true end
		if ls then ls.sineX.amp=0.35; ls.sineX.speed=7.5 end
		if rj then rj.sinePosY.amp=0.08; rj.sinePosY.speed=15 end
		if ne then ne.sineY.amp=0.04; ne.sineY.speed=7.5 end
	end},
	{name="Crazy",apply=function()
		pushUndo()
		resetAllJointData()
		for _,name in ipairs(jointOrder) do
			local d=allJointData[name]; if not d then continue end
			for _,ax in ipairs({"X","Y","Z"}) do
				d["sine"..ax].amp=math.random()*TWO_PI*0.5
				d["sine"..ax].speed=math.random()*4+0.5
				d["sine"..ax].reverse=math.random()>0.5
				d["spin"..ax].enabled=math.random()>0.5
				d["spin"..ax].speed=math.random()*3+0.5
				d["spin"..ax].reverse=math.random()>0.5
			end
		end
	end},
	{name="Reset All",apply=function()
		pushUndo()
		resetAllJointData()
	end},
}
for _,p in ipairs(PRESETS) do
	local b=btn({Size=UDim2.new(0,0,0,px(22)),AutomaticSize=Enum.AutomaticSize.X,
		BackgroundColor3=C.elevated,Text=" "..p.name.." ",
		TextSize=FS.tiny,Font=Enum.Font.GothamBold},PresetRow)
	pad(0,0,px(5),px(5),b); crn(px(4),b)
	b.MouseButton1Click:Connect(function()
		p.apply()
		rebuildJointUI()
	end)
end

