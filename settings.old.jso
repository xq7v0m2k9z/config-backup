--  EXPORT / JSON
-- ═══════════════════════════════════════════════════════════════════════
local previewFrozen=false
local jsonImportArmed=false
local jsonDisplayMode=false
ExportBtn.MouseButton1Click:Connect(function()
	jsonImportArmed=false
	jsonDisplayMode=false
	CodeLabel.TextEditable=false
	CodeLabel.PlaceholderText=""
	CodeLabel.TextColor3=C.code
	previewFrozen=not previewFrozen
	ExportBtn.TextColor3=previewFrozen and C.warn or C.accent
	ExportBtn.Text=previewFrozen and " ⬡ Frozen " or " ⬡ Export "
	if previewFrozen then CodeLabel.Text=generateCode() end
end)

local function serializeData()
	local t={}
	for _,name in ipairs(jointOrder) do
		local d=allJointData[name]; if not d then continue end
		local function copySine(s) return {amp=s.amp,speed=s.speed,offset=s.offset,reverse=s.reverse} end
		local function copySpin(s) return {enabled=s.enabled,speed=s.speed,reverse=s.reverse} end
		t[name]={
			posX=d.posX,posY=d.posY,posZ=d.posZ,
			rotX=d.rotX,rotY=d.rotY,rotZ=d.rotZ,
			baseRotX=d.baseRotX or 0,baseRotY=d.baseRotY or 0,baseRotZ=d.baseRotZ or 0,
			selfPivotX=d.selfPivotX or 0,selfPivotY=d.selfPivotY or 0,selfPivotZ=d.selfPivotZ or 0,
			baseRotationFirst=d.baseRotationFirst,
			lockX=d.lockX,lockY=d.lockY,lockZ=d.lockZ,
			sineX=copySine(d.sineX),sineY=copySine(d.sineY),sineZ=copySine(d.sineZ),
			sinePosX=copySine(d.sinePosX),sinePosY=copySine(d.sinePosY),sinePosZ=copySine(d.sinePosZ),
			spinX=copySpin(d.spinX),spinY=copySpin(d.spinY),spinZ=copySpin(d.spinZ),
			baseSineX=copySine(d.baseSineX),baseSineY=copySine(d.baseSineY),baseSineZ=copySine(d.baseSineZ),
			baseSpinX=copySpin(d.baseSpinX),baseSpinY=copySpin(d.baseSpinY),baseSpinZ=copySpin(d.baseSpinZ),
			enabled=d.enabled,
		}
	end
	return t
end

JsonExpBtn.MouseButton1Click:Connect(function()
	jsonImportArmed=false
	jsonDisplayMode=true
	CodeLabel.TextEditable=false
	CodeLabel.PlaceholderText=""
	CodeLabel.TextColor3=C.code
	local ok,json=pcall(function() return HttpService:JSONEncode(serializeData()) end)
	CodeLabel.Text=ok and json or "-- JSON encode failed"
end)

local NUMBER_FIELDS={"posX","posY","posZ","rotX","rotY","rotZ","baseRotX","baseRotY","baseRotZ",
	"selfPivotX","selfPivotY","selfPivotZ"}
local BOOLEAN_FIELDS={"enabled","baseRotationFirst","lockX","lockY","lockZ"}
local SINE_FIELDS={"sineX","sineY","sineZ","sinePosX","sinePosY","sinePosZ",
	"baseSineX","baseSineY","baseSineZ"}
local SPIN_FIELDS={"spinX","spinY","spinZ","baseSpinX","baseSpinY","baseSpinZ"}
local function validateImportTable(data)
	if type(data)~="table" then return false end
	for name,values in pairs(data) do
		if type(name)~="string" or type(values)~="table" then return false end
		for _,key in ipairs(NUMBER_FIELDS) do
			if values[key]~=nil and not isSafeNumber(values[key]) then return false end
		end
		for _,key in ipairs(BOOLEAN_FIELDS) do
			if values[key]~=nil and type(values[key])~="boolean" then return false end
		end
		for _,key in ipairs(SINE_FIELDS) do
			local axis=values[key]
			if axis~=nil then
				if type(axis)~="table" then return false end
				for _,numberKey in ipairs({"amp","speed","offset"}) do
					if axis[numberKey]~=nil and not isSafeNumber(axis[numberKey]) then return false end
				end
				if axis.reverse~=nil and type(axis.reverse)~="boolean" then return false end
			end
		end
		for _,key in ipairs(SPIN_FIELDS) do
			local axis=values[key]
			if axis~=nil then
				if type(axis)~="table" then return false end
				if axis.speed~=nil and not isSafeNumber(axis.speed) then return false end
				if axis.enabled~=nil and type(axis.enabled)~="boolean" then return false end
				if axis.reverse~=nil and type(axis.reverse)~="boolean" then return false end
			end
		end
	end
	return true
end

local function applyImportedTable(data)
	for name,values in pairs(data) do
		local d=allJointData[name]
		if d then
			for _,key in ipairs(NUMBER_FIELDS) do if values[key]~=nil then d[key]=values[key] end end
			for _,key in ipairs(BOOLEAN_FIELDS) do if values[key]~=nil then d[key]=values[key] end end
			for _,key in ipairs(SINE_FIELDS) do
				if values[key] then for _,field in ipairs({"amp","speed","offset","reverse"}) do
					if values[key][field]~=nil then d[key][field]=values[key][field] end
				end end
			end
			for _,key in ipairs(SPIN_FIELDS) do
				if values[key] then for _,field in ipairs({"enabled","speed","reverse"}) do
					if values[key][field]~=nil then d[key][field]=values[key][field] end
				end end
			end
		end
	end
end

JsonImpBtn.MouseButton1Click:Connect(function()
	if not jsonImportArmed then
		jsonImportArmed=true
		jsonDisplayMode=true
		CodeLabel.TextEditable=true
		CodeLabel.Text=""
		CodeLabel.TextColor3=C.code
		CodeLabel.PlaceholderText="Paste JSON here, then click ↑ JSON to import"
		CodeLabel:CaptureFocus()
		return
	end

	local ok,data=pcall(function() return HttpService:JSONDecode(CodeLabel.Text) end)
	if not ok or not validateImportTable(data) then
		CodeLabel.TextColor3=C.red
		CodeLabel.PlaceholderText="Invalid JSON or values; correct it and click ↑ JSON again"
		return
	end

	pushUndo()
	applyImportedTable(data)
	jsonImportArmed=false
	jsonDisplayMode=false
	CodeLabel.TextEditable=false
	CodeLabel.PlaceholderText=""
	CodeLabel.TextColor3=C.code
	CodeLabel.Text="-- ✓ JSON imported"
	rebuildJointUI()
end)

