--  CHARACTER RESPAWN
-- ═══════════════════════════════════════════════════════════════════════
player.CharacterAdded:Connect(function(newChar)
	if rtConn then rtConn:Disconnect(); rtConn=nil end
	clearCharacterWatch()
	char=newChar
	undoStack,redoStack={},{}
	waitForRig(newChar)
	disableAnimate(newChar)
	detectAllMotors(newChar)
	rebuildJointUI()
	watchCharacter(newChar)
	startRuntime()
end)

-- ═══════════════════════════════════════════════════════════════════════
--  INIT
-- ═══════════════════════════════════════════════════════════════════════
task.delay(0.25,function()
	if not jsonDisplayMode and not previewFrozen then CodeLabel.Text=generateCode() end
end)
local n=0; for _ in pairs(allJointData) do n=n+1 end
print(fmt("[CFrameAnimEditor v3.1]  scale=%.2fx  %dx%d  joints=%d",S,WIN_W,WIN_H,n))
