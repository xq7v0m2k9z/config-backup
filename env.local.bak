	TweenService:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {
		Size = minimised and UDim2.fromOffset(WIN_W, TITLE_H)
		              or UDim2.fromOffset(WIN_W, WIN_H)
	}):Play()
