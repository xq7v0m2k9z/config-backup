-- ═══════════════════════════════════════════════════════════════════════
local vfxList   = {}
local vfxNextId = 1
local vfxConns  = {}
local exportFunctionName = "mode1vfx"
local exportAutoConnect  = false -- true = exported code connects itself to Heartbeat

-- FIX: deep copy helper for nested tables
local function deepCopy(t)
	if type(t) ~= "table" then return t end
	local c = {}
	for k, v in pairs(t) do c[k] = deepCopy(v) end
	return c
end

local function newElement(typ)
	local id = vfxNextId; vfxNextId = vfxNextId + 1
	return {
		id=id, type=typ, name=typ.." "..id,
		parentPart="HumanoidRootPart", enabled=true,

		-- appearance (Part / SpecialMesh)
		color={180,170,255}, material="Neon", transparency=0.2, castShadow=false,
		shape="Ball", size={1,1,1},
		meshType="Sphere", meshId="", textureId="", meshScale={1,1,1},

		-- base transform
		offsetPos={0,2,0}, offsetRot={0,0,0},
		spawnAtGround=false, groundOffset=0.5,

		-- lerp position sine bob
		animPos=false,   animPosAmp={0,0.5,0}, animPosSpeed=2,
		-- lerp rotation sine oscillate
		animRot=false,   animRotAmp={0,20,0},  animRotSpeed=1.5,
		-- infinite spin
		infRot=false,    infRotAxis={0,1,0},   infRotSpeed=90,
		-- scale pulse (sin size)
		animScale=false, animScaleAmp=0.3,     animScaleSpeed=1.5,

		-- Beam
		color0={255,255,255}, color1={127,119,221},
		width0=0.5, width1=0, beamLength=6, segments=12,
		faceCamera=true, lightInfluence=0,

		-- Trail
		trailLifetime=0.5, trailWidth=0.5, trailMinDist=0.05,

		-- ParticleEmitter  (FIX: no lightInfluence field here — PE doesn't have it)
		peColor={180,170,255}, peRate=30, peAutoSmoothRate=true,
		peSpeedMin=2, peSpeedMax=5,
		peLifetimeMin=0.4, peLifetimeMax=0.8,
		peSize=0.35, peSpread=180, peTexture="rbxassetid://1266170131",
		peOrientation="FacingCamera", peLockedToPart=false, peRotationMin=0, peRotationMax=360,
		peRotSpeedMin=0, peRotSpeedMax=0,
		peTransparency=0, peSquash=0, peLightEmission=0, peLightInfluence=0, peBrightness=1,
		peDrag=0, peZOffset=0, peTimeScale=1, peVelocityInheritance=0,
		peAccel={0,0,0}, peEmissionDirection="Top",
		peShape="Box", peShapeStyle="Volume", peShapeInOut="Outward", peShapePartial=1,
		peFlipbookLayout="None", peFlipbookMode="Loop", peFlipbookFramerate=15, peFlipbookStartRandom=false,
		-- curves (nil = use the flat value). numeric key = {time, value, envelope}; colour key = {time, {r,g,b}}
		peSizeCurve=nil, peTransCurve=nil, peSquashCurve=nil, peColorCurve=nil,


		-- BillboardGui
		bbText="VFX!", bbTextColor={255,255,255}, bbBgColor={20,20,50},
		bbBgTrans=0.1, bbSizeX=80, bbSizeY=40, bbOffsetY=3, bbAlwaysOnTop=true,

		-- runtime
		_instances={}, _infAngle=0, _sine=0,
	}
end

-- ═══════════════════════════════════════════════════════════════════════
--  SPAWN / DESTROY
-- ═══════════════════════════════════════════════════════════════════════
local function c3(t)
	return c3r(math.round(t[1]), math.round(t[2]), math.round(t[3]))
end

local function assetIdText(id)
	local s = tostring(id or ""):gsub("%s+", "")
	if s == "" then return "" end
	if s:match("^%d+$") then return "rbxassetid://" .. s end
	return s
end

local function particleRate(el)
	local rate = math.max(0, tonumber(el.peRate) or 0)
	if el.peAutoSmoothRate == false then return rate end

	local minLifetime = math.min(
		type(el.peLifetimeMin) == "number" and el.peLifetimeMin or 0.4,
		type(el.peLifetimeMax) == "number" and el.peLifetimeMax or 0.8
	)
	minLifetime = math.max(minLifetime, 0.05)
	return math.max(rate, 1.5 / minLifetime)
end

-- ParticleEmitter helpers (kept in one table so the main chunk stays under the 200-local limit)
local PE = {}
local fmtN -- forward declaration (assigned in CODE EXPORT)

function PE.sorted(curve)
	local s = {}
	for i, p in ipairs(curve) do s[i] = p end
	table.sort(s, function(a, b) return a[1] < b[1] end)
	s[1]  = {0, s[1][2], s[1][3]}
	s[#s] = {1, s[#s][2], s[#s][3]}
	for i = 2, #s do
		if s[i][1] <= s[i-1][1] then s[i] = {math.min(1, s[i-1][1] + 0.001), s[i][2], s[i][3]} end
	end
	return s
end

function PE.numSeq(curve, flat)
	if type(curve) ~= "table" or #curve < 2 then return NumberSequence.new(flat) end
	local k = {}
	for i, p in ipairs(PE.sorted(curve)) do
		k[i] = NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0)
	end
	return NumberSequence.new(k)
end

function PE.colSeq(curve, rgb)
	if type(curve) ~= "table" or #curve < 2 then return ColorSequence.new(c3(rgb)) end
	local k = {}
	for i, p in ipairs(PE.sorted(curve)) do
		k[i] = ColorSequenceKeypoint.new(p[1], c3(p[2]))
	end
	return ColorSequence.new(k)
end

function PE.apply(pe, el)
	pe.Color        = PE.colSeq(el.peColorCurve, el.peColor)
	pe.Size         = PE.numSeq(el.peSizeCurve, el.peSize)
	pe.Transparency = PE.numSeq(el.peTransCurve, el.peTransparency or 0)
	pe.Squash       = PE.numSeq(el.peSquashCurve, el.peSquash or 0)
	pe.Rate         = particleRate(el)
	pe.Speed        = NumberRange.new(math.min(el.peSpeedMin, el.peSpeedMax), math.max(el.peSpeedMin, el.peSpeedMax))
	pe.Lifetime     = NumberRange.new(math.min(el.peLifetimeMin, el.peLifetimeMax), math.max(el.peLifetimeMin, el.peLifetimeMax))
	pe.SpreadAngle  = Vector2.new(-el.peSpread, el.peSpread)
	pe.Orientation  = Enum.ParticleOrientation[el.peOrientation] or Enum.ParticleOrientation.FacingCamera
	pe.LockedToPart = el.peLockedToPart == true
	pe.Rotation     = NumberRange.new(math.min(el.peRotationMin, el.peRotationMax), math.max(el.peRotationMin, el.peRotationMax))
	pe.RotSpeed     = NumberRange.new(math.min(el.peRotSpeedMin, el.peRotSpeedMax), math.max(el.peRotSpeedMin, el.peRotSpeedMax))
	pe.Texture      = assetIdText(el.peTexture)
	pe.LightEmission        = el.peLightEmission or 0
	pe.LightInfluence       = el.peLightInfluence or 0
	pe.Brightness           = el.peBrightness or 1
	pe.Drag                 = el.peDrag or 0
	pe.ZOffset              = el.peZOffset or 0
	pe.TimeScale            = el.peTimeScale or 1
	pe.VelocityInheritance  = el.peVelocityInheritance or 0
	local a = el.peAccel or {0, 0, 0}
	pe.Acceleration         = v3n(a[1], a[2], a[3])
	pe.EmissionDirection    = Enum.NormalId[el.peEmissionDirection or "Top"] or Enum.NormalId.Top
	pcall(function()
		pe.Shape          = Enum.ParticleEmitterShape[el.peShape or "Box"]
		pe.ShapeStyle     = Enum.ParticleEmitterShapeStyle[el.peShapeStyle or "Volume"]
		pe.ShapeInOut     = Enum.ParticleEmitterShapeInOut[el.peShapeInOut or "Outward"]
		pe.ShapePartial   = el.peShapePartial or 1
	end)
	pcall(function()
		pe.FlipbookLayout      = Enum.ParticleFlipbookLayout[el.peFlipbookLayout or "None"]
		pe.FlipbookMode        = Enum.ParticleFlipbookMode[el.peFlipbookMode or "Loop"]
		pe.FlipbookFramerate   = NumberRange.new(el.peFlipbookFramerate or 15)
		pe.FlipbookStartRandom = el.peFlipbookStartRandom == true
	end)
end

function PE.fmtCurve(curve, isColor)
	local parts = {}
	for i, p in ipairs(curve) do
		if isColor then
			parts[i] = fmt("{%s,%d,%d,%d}", fmtN(p[1]), math.round(p[2][1]), math.round(p[2][2]), math.round(p[2][3]))
		else
			parts[i] = fmt("{%s,%s,%s}", fmtN(p[1]), fmtN(p[2]), fmtN(p[3] or 0))
		end
	end
	return "{" .. table.concat(parts, ",") .. "}"
end

local function copyToClipboard(value)
	local candidates = {}
	local seen = {}
	local function add(fn, owner)
		if type(fn) == "function" and not seen[fn] then
			seen[fn] = true
			candidates[#candidates + 1] = {fn=fn, owner=owner}
		end
	end

	add(setclipboard)
	add(toclipboard)
	add(writeclipboard)
	local okSyn, synClipboard = pcall(function() return syn and syn.clipboard end)
	if okSyn and type(synClipboard) == "table" then add(synClipboard.set, synClipboard) end
	local okClipboard, clipboard = pcall(function() return Clipboard end)
	if okClipboard and type(clipboard) == "table" then add(clipboard.set, clipboard) end

	for _, candidate in ipairs(candidates) do
		local ok, result = pcall(candidate.fn, value)
		if ok and result ~= false then return true end
		if candidate.owner then
			ok, result = pcall(candidate.fn, candidate.owner, value)
			if ok and result ~= false then return true end
		end
	end
	return false
end

local groundRayParams = RaycastParams.new()
groundRayParams.FilterType = Enum.RaycastFilterType.Exclude
groundRayParams.IgnoreWater = true
groundRayParams.RespectCanCollide = true

local function groundOriginCFrame(parentCF, lift, pack)
	local pos = parentCF.Position
	local filter = {}

	if lp.Character then
		filter[#filter + 1] = lp.Character
	end

	if pack and pack._instances then
		for _, inst in ipairs(pack._instances) do
			if inst then
				filter[#filter + 1] = inst
			end
		end
	end

	local vfxFolder = workspace:FindFirstChild("VFX")
	if vfxFolder then
		filter[#filter + 1] = vfxFolder
	end

	local reanimateFolder = workspace:FindFirstChild("Reanimate")
	if reanimateFolder then
		filter[#filter + 1] = reanimateFolder
	end

	groundRayParams.FilterDescendantsInstances = filter

	local hit = workspace:Raycast(
		pos + v3n(0, 80, 0),
		v3n(0, -600, 0),
		groundRayParams
	)

	if not hit then
		return parentCF
	end

	local rotOnly = parentCF - parentCF.Position
	return CFrame.new(
		pos.X,
		hit.Position.Y + (lift or 0.5),
		pos.Z
	) * rotOnly
end

local function getOriginCFrame(el, parentPart, pack)
	local baseCF = parentPart and parentPart.CFrame
	if not baseCF then
		return nil
	end

	if el.spawnAtGround then
		return groundOriginCFrame(baseCF, el.groundOffset, pack)
	end

	return baseCF
end

-- FIX: helper to make invisible host parts consistently
local function makeHost(name, pack)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = v3n(0.1, 0.1, 0.1)
	p.Parent = workspace

	if pack and pack._instances then
		pack._instances[#pack._instances + 1] = p
	end

	return p
end

local function destroyElement(el)
	if vfxConns[el.id] then
		vfxConns[el.id]:Disconnect()
		vfxConns[el.id] = nil
	end

	for _, inst in ipairs(el._instances or {}) do
		if inst and inst.Parent then
			for _, ch in ipairs(inst:GetDescendants()) do
				if ch:IsA("ParticleEmitter") then
					ch.Enabled = false
				end
			end

			task.delay(0.6, function()
				if inst and inst.Parent then
					inst:Destroy()
				end
			end)
		end
	end

	el._instances = {}
	el._positioned = false
end

local function applyElementProperties(el)
	local root = el._instances and el._instances[1]
	if not root or not root.Parent then return end
	local isOn = el.enabled ~= false

	if el.type == "Part" then
		root.Name         = el.name:gsub("%s", "_")
		root.CastShadow   = el.castShadow
		root.Color        = c3(el.color)
		root.Material     = Enum.Material[el.material] or Enum.Material.Neon
		root.Transparency = isOn and el.transparency or 1
		pcall(function() root.Shape = Enum.PartType[el.shape] or Enum.PartType.Ball end)
		if not el.animScale then root.Size = v3n(table.unpack(el.size)) end

	elseif el.type == "SpecialMesh" then
		root.Name         = el.name:gsub("%s", "_")
		root.Color        = c3(el.color)
		root.Material     = Enum.Material[el.material] or Enum.Material.Neon
		root.Transparency = isOn and el.transparency or 1
		local mesh = root:FindFirstChildOfClass("SpecialMesh")
		if mesh then
			mesh.MeshType = Enum.MeshType[el.meshType] or Enum.MeshType.Sphere
			if not el.animScale then mesh.Scale = v3n(table.unpack(el.meshScale)) end
			mesh.MeshId    = assetIdText(el.meshId)
			mesh.TextureId = assetIdText(el.textureId)
		end

	elseif el.type == "Beam" then
		local beam = root:FindFirstChildOfClass("Beam")
		if beam then
			beam.Enabled = isOn
			beam.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, c3(el.color0)),
				ColorSequenceKeypoint.new(1, c3(el.color1)),
			})
			beam.Width0         = el.width0
			beam.Width1         = el.width1
			beam.Segments       = el.segments
			beam.FaceCamera     = el.faceCamera
			beam.LightInfluence = el.lightInfluence
		end
		local attachments = {}
		for _, ch in ipairs(root:GetChildren()) do
			if ch:IsA("Attachment") then attachments[#attachments + 1] = ch end
		end
		if attachments[2] then attachments[2].Position = v3n(0, 0, -el.beamLength) end

	elseif el.type == "Trail" then
		local trail = root:FindFirstChildOfClass("Trail")
		if trail then
			trail.Enabled = isOn
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, c3(el.color0)),
				ColorSequenceKeypoint.new(1, c3(el.color1)),
			})
			trail.Lifetime    = el.trailLifetime
			trail.MinDistance = el.trailMinDist
		end
		local attachments = {}
		for _, ch in ipairs(root:GetChildren()) do
			if ch:IsA("Attachment") then attachments[#attachments + 1] = ch end
		end
		if attachments[2] then attachments[2].Position = v3n(0, el.trailWidth, 0) end

	elseif el.type == "ParticleEmitter" then
		local pe = root:FindFirstChildOfClass("ParticleEmitter")
		if pe then
			pe.Enabled     = isOn and el._positioned == true
			PE.apply(pe, el)
		end

	elseif el.type == "BillboardGui" then
		local bb = root:FindFirstChildOfClass("BillboardGui")
		if bb then
			bb.Enabled     = isOn
			bb.Size        = UDim2.new(0, el.bbSizeX, 0, el.bbSizeY)
			bb.AlwaysOnTop = el.bbAlwaysOnTop
			bb.Adornee     = root
			local label = bb:FindFirstChildOfClass("TextLabel")
			if label then
				label.BackgroundColor3       = c3(el.bbBgColor)
				label.BackgroundTransparency = el.bbBgTrans
				label.TextColor3             = c3(el.bbTextColor)
				label.Text                   = el.bbText
			end
		end
	end
end

local function refreshElement(el)
	applyElementProperties(el)
end

local function refreshSpawnedElements()
	for _, el in ipairs(vfxList) do
		refreshElement(el)
	end
end

local function spawnElement(el)
	destroyElement(el)
	el._positioned = false
	el._infAngle = 0
	el._sine     = 0

	local pp = getBodyPart(el.parentPart)
	if not pp then
		warn("[VFX] body part not found: " .. el.parentPart)
		return
	end

	local rootPart
	local meshInst

	-- --- Part ---------------------------------------------------------------------------------------
	if el.type == "Part" then
		local p = Instance.new("Part")
		p.Name         = el.name:gsub("%s", "_")
		p.Anchored     = true
		p.CanCollide   = false
		p.CanQuery     = false
		p.CanTouch     = false
		p.CastShadow   = el.castShadow
		p.Color        = c3(el.color)
		p.Material     = Enum.Material[el.material] or Enum.Material.Neon
		p.Transparency = el.transparency
		p.Shape        = Enum.PartType[el.shape] or Enum.PartType.Ball
		p.Size         = v3n(table.unpack(el.size))
		p.Parent       = workspace
		table.insert(el._instances, p)
		rootPart = p

	-- --- SpecialMesh ---------------------------------------------------------------------------─
	elseif el.type == "SpecialMesh" then
		local p = Instance.new("Part")
		p.Name         = el.name:gsub("%s", "_")
		p.Anchored     = true
		p.CanCollide   = false
		p.CanQuery     = false
		p.CanTouch     = false
		p.CastShadow   = false
		p.Color        = c3(el.color)
		p.Material     = Enum.Material[el.material] or Enum.Material.Neon
		p.Transparency = el.transparency
		p.Size         = v3n(2, 2, 2)
		local m = Instance.new("SpecialMesh", p)
		m.MeshType     = Enum.MeshType[el.meshType] or Enum.MeshType.Sphere
		m.Scale        = v3n(table.unpack(el.meshScale))
		if assetIdText(el.meshId)    ~= "" then m.MeshId    = assetIdText(el.meshId)    end
		if assetIdText(el.textureId) ~= "" then m.TextureId = assetIdText(el.textureId) end
		meshInst = m
		p.Parent = workspace
		table.insert(el._instances, p)
		rootPart = p

	-- --- Beam ---------------------------------------------------------------------------------------
	elseif el.type == "Beam" then
		local hp = makeHost("VFX_BeamHost_" .. el.id)
		local a0 = Instance.new("Attachment", hp)
		local a1 = Instance.new("Attachment", hp)
		a1.Position = v3n(0, 0, -el.beamLength)
		local bm = Instance.new("Beam", hp)
		bm.Attachment0 = a0; bm.Attachment1 = a1
		bm.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, c3(el.color0)),
			ColorSequenceKeypoint.new(1, c3(el.color1)),
		})
		bm.Width0         = el.width0
		bm.Width1         = el.width1
		bm.Segments       = el.segments
		bm.FaceCamera     = el.faceCamera
		bm.LightInfluence = el.lightInfluence
		table.insert(el._instances, hp)
		rootPart = hp

	-- --- Trail ------------------------------------------------------------------------------------─
	elseif el.type == "Trail" then
		local tp = makeHost("VFX_TrailHost_" .. el.id)
		local ta0 = Instance.new("Attachment", tp)
		local ta1 = Instance.new("Attachment", tp)
		ta1.Position = v3n(0, el.trailWidth, 0)
		local tr = Instance.new("Trail", tp)
		tr.Attachment0 = ta0; tr.Attachment1 = ta1
		tr.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, c3(el.color0)),
			ColorSequenceKeypoint.new(1, c3(el.color1)),
		})
		tr.Lifetime    = el.trailLifetime
		tr.MinDistance = el.trailMinDist
		table.insert(el._instances, tp)
		rootPart = tp

	-- --- ParticleEmitter ---------------------------------------------------------------------─
	elseif el.type == "ParticleEmitter" then
		local ep = makeHost("VFX_EmitHost_" .. el.id)
		local pe = Instance.new("ParticleEmitter", ep)
		pe.Enabled     = false
		PE.apply(pe, el)
		-- FIX: ParticleEmitter has no LightInfluence — removed
		table.insert(el._instances, ep)
		rootPart = ep

	-- --- BillboardGui ---------------------------------------------------------------------------
	elseif el.type == "BillboardGui" then
		local bp = makeHost("VFX_BBHost_" .. el.id)
		local bb = Instance.new("BillboardGui", bp)
		bb.Size        = UDim2.new(0, el.bbSizeX, 0, el.bbSizeY)
		bb.AlwaysOnTop = el.bbAlwaysOnTop
		bb.Adornee     = bp
		local lbl2 = Instance.new("TextLabel", bb)
		lbl2.Size                = UDim2.new(1, 0, 1, 0)
		lbl2.BackgroundColor3    = c3(el.bbBgColor)
		lbl2.BackgroundTransparency = el.bbBgTrans
		lbl2.TextColor3          = c3(el.bbTextColor)
		lbl2.Text                = el.bbText
		lbl2.TextScaled          = true
		lbl2.BorderSizePixel     = 0
		Instance.new("UICorner", lbl2).CornerRadius = UDim.new(0.3, 0)
		table.insert(el._instances, bp)
		rootPart = bp
	end

	if not rootPart then return end
	applyElementProperties(el)

	-- --- Per-frame animation ---------------------------------------------------------------─
	vfxConns[el.id] = RunService.Heartbeat:Connect(function(dt)
		if not el.enabled then return end
		local pp2 = getBodyPart(el.parentPart)
		if not pp2 or not rootPart.Parent then return end

		el._sine = el._sine + dt

		-- position with optional sine bob
		local ox = el.offsetPos[1]
		local oy = el.offsetPos[2]
		local oz = el.offsetPos[3]
		if el.animPos then
			local t = el._sine * el.animPosSpeed * (2 * pi)
			ox = ox + el.animPosAmp[1] * sin(t)
			oy = oy + el.animPosAmp[2] * sin(t)
			oz = oz + el.animPosAmp[3] * sin(t)
		end

		-- rotation with optional sine oscillation
		local rx = rad(el.offsetRot[1])
		local ry = rad(el.offsetRot[2])
		local rz = rad(el.offsetRot[3])
		if el.animRot then
			local t = el._sine * el.animRotSpeed * (2 * pi)
			rx = rx + rad(el.animRotAmp[1]) * sin(t)
			ry = ry + rad(el.animRotAmp[2]) * sin(t)
			rz = rz + rad(el.animRotAmp[3]) * sin(t)
		end

		-- lerp speed factor
		local lf = math.min(1, ALPHA * 60 * dt + 0.3)

		-- build target CFrame
		local originCF = getOriginCFrame(el, pp2)
		local baseCF = originCF * cfn(ox, oy, oz) * cfaa(rx, ry, rz)
		local snapToTarget = not el._positioned

		if el.infRot then
			el._infAngle = el._infAngle + rad(el.infRotSpeed) * dt
			local ax = v3n(el.infRotAxis[1], el.infRotAxis[2], el.infRotAxis[3])
			local safeAxis = ax.Magnitude > 0 and ax.Unit or v3n(0, 1, 0)
			local spinCF = CFrame.fromAxisAngle(safeAxis, el._infAngle)
			local targetCF = baseCF * spinCF
			rootPart.CFrame = snapToTarget and targetCF or rootPart.CFrame:Lerp(targetCF, lf)
		else
			rootPart.CFrame = snapToTarget and baseCF or rootPart.CFrame:Lerp(baseCF, lf)
		end

		-- billboard Y offset override (applied on top of base)
		if el.type == "BillboardGui" then
			local bbCF = originCF * cfn(ox, oy + el.bbOffsetY, oz)
			rootPart.CFrame = snapToTarget and bbCF or rootPart.CFrame:Lerp(bbCF, lf)
		end

		if snapToTarget then
			el._positioned = true
			if el.type == "ParticleEmitter" then applyElementProperties(el) end
		end

		-- FIX: scale pulse (sin size) — works for Part and SpecialMesh
		if el.animScale then
			local sc = 1 + el.animScaleAmp * sin(el._sine * el.animScaleSpeed * 2 * pi)
			sc = math.max(0.01, sc) -- never go zero/negative
			if el.type == "Part" then
				rootPart.Size = v3n(
					el.size[1] * sc,
					el.size[2] * sc,
					el.size[3] * sc
				)
			elseif el.type == "SpecialMesh" and meshInst then
				meshInst.Scale = v3n(
					el.meshScale[1] * sc,
					el.meshScale[2] * sc,
					el.meshScale[3] * sc
				)
			end
		end
	end)
end

-- ═══════════════════════════════════════════════════════════════════════
--  CODE EXPORT
-- ═══════════════════════════════════════════════════════════════════════
fmtN = function(n) return fmt("%.4g", n) end
local function fmtV3(t) return fmt("Vector3.new(%s,%s,%s)", fmtN(t[1]), fmtN(t[2]), fmtN(t[3])) end
local function fmtC3(t) return fmt("Color3.fromRGB(%d,%d,%d)", math.round(t[1]), math.round(t[2]), math.round(t[3])) end
local function fmtS(s)  return fmt("%q", tostring(s or "")) end
local function fmtArr(t)
	local out = {}
	for i = 1, #(t or {}) do
		out[i] = fmtN(t[i] or 0)
	end
	return "{" .. table.concat(out, ",") .. "}"
end
local function fmtIdent(s)
	s = tostring(s or "GeneratedVFX"):gsub("[^%w_]", "_")
	s = s:gsub("_+", "_"):gsub("^_+", ""):gsub("_+$", "")
	if s == "" then s = "GeneratedVFX" end
	if s:match("^%d") then s = "VFX_" .. s end
	return s
end

local function generateCode()
	local L = {}
	local function push(s) L[#L+1] = s end

	push("-- VFX Animator reanimation export")
	push("-- Returns a table. Call VFX.new(ctx):spawn(), then call vfx:update(dt) from your existing Heartbeat.")
	push("-- Reanimation ctx example: {getPart=getPart,cframes=cframes,ws=ws,cf=cf,cfMul=cfMul,angles=angles,Destroy=Destroy}")
	push("local VFX = {}")
	push("VFX.__index = VFX")
	push("")
	push("local DATA = {")

	for _, el in ipairs(vfxList) do
		push("  {")
		push(fmt("    id=%d, type=%s, name=%s, parentPart=%s, enabled=%s,",
			el.id, fmtS(el.type), fmtS(el.name), fmtS(el.parentPart), tostring(el.enabled ~= false)))
		push(fmt("    color=%s, material=%s, transparency=%s, castShadow=%s, shape=%s, size=%s,",
			fmtArr(el.color), fmtS(el.material), fmtN(el.transparency), tostring(el.castShadow == true), fmtS(el.shape), fmtArr(el.size)))
		push(fmt("    meshType=%s, meshId=%s, textureId=%s, meshScale=%s,",
			fmtS(el.meshType), fmtS(el.meshId), fmtS(el.textureId), fmtArr(el.meshScale)))
		push(fmt("    offsetPos=%s, offsetRot=%s,",
			fmtArr(el.offsetPos), fmtArr(el.offsetRot)))
		push(fmt("    animPos=%s, animPosAmp=%s, animPosSpeed=%s,",
			tostring(el.animPos == true), fmtArr(el.animPosAmp), fmtN(el.animPosSpeed)))
		push(fmt("    animRot=%s, animRotAmp=%s, animRotSpeed=%s,",
			tostring(el.animRot == true), fmtArr(el.animRotAmp), fmtN(el.animRotSpeed)))
		push(fmt("    infRot=%s, infRotAxis=%s, infRotSpeed=%s,",
			tostring(el.infRot == true), fmtArr(el.infRotAxis), fmtN(el.infRotSpeed)))
		push(fmt("    animScale=%s, animScaleAmp=%s, animScaleSpeed=%s,",
			tostring(el.animScale == true), fmtN(el.animScaleAmp), fmtN(el.animScaleSpeed)))
		push(fmt("    color0=%s, color1=%s, width0=%s, width1=%s, beamLength=%s, segments=%d, faceCamera=%s, lightInfluence=%s,",
			fmtArr(el.color0), fmtArr(el.color1), fmtN(el.width0), fmtN(el.width1), fmtN(el.beamLength), math.round(el.segments), tostring(el.faceCamera == true), fmtN(el.lightInfluence)))
		push(fmt("    trailLifetime=%s, trailWidth=%s, trailMinDist=%s,",
			fmtN(el.trailLifetime), fmtN(el.trailWidth), fmtN(el.trailMinDist)))
		push(fmt("    peColor=%s, peRate=%s, peSpeedMin=%s, peSpeedMax=%s, peLifetimeMin=%s, peLifetimeMax=%s, peSize=%s, peSpread=%s,",
			fmtArr(el.peColor), fmtN(particleRate(el)), fmtN(el.peSpeedMin), fmtN(el.peSpeedMax), fmtN(el.peLifetimeMin), fmtN(el.peLifetimeMax), fmtN(el.peSize), fmtN(el.peSpread)))
		push(fmt("    bbText=%s, bbTextColor=%s, bbBgColor=%s, bbBgTrans=%s, bbSizeX=%d, bbSizeY=%d, bbOffsetY=%s, bbAlwaysOnTop=%s,",
			fmtS(el.bbText), fmtArr(el.bbTextColor), fmtArr(el.bbBgColor), fmtN(el.bbBgTrans), math.round(el.bbSizeX), math.round(el.bbSizeY), fmtN(el.bbOffsetY), tostring(el.bbAlwaysOnTop == true)))
		push("  },")
	end

	push("}")
	push("")
	push("local function rgb(t)")
	push("  return Color3.fromRGB(math.round(t[1] or 0), math.round(t[2] or 0), math.round(t[3] or 0))")
	push("end")
	push("")
	push("local function vec(t)")
	push("  return Vector3.new(t[1] or 0, t[2] or 0, t[3] or 0)")
	push("end")
	push("")
	push("local function makeEnv(ctx)")
	push("  ctx = ctx or {}")
	push("  local Players = game:GetService('Players')")
	push("  local lp = ctx.lp or Players.LocalPlayer")
	push("  local env = {}")
	push("  env.ws = ctx.ws or workspace")
	push("  env.cframes = ctx.cframes or {}")
	push("  env.cf = ctx.cf or CFrame.new")
	push("  env.cfMul = ctx.cfMul or function(a, b) return a * b end")
	push("  env.angles = ctx.angles or CFrame.Angles")
	push("  env.rad = ctx.rad or math.rad")
	push("  env.destroy = ctx.Destroy or ctx.destroy or function(inst) inst:Destroy() end")
	push("  env.getPart = ctx.getPart or function(name)")
	push("    local char = lp and lp.Character")
	push("    return char and (char:FindFirstChild(name) or char:FindFirstChild(name, true))")
	push("  end")
	push("  env.getBaseCFrame = ctx.getBaseCFrame or function(part)")
	push("    if not part then return nil end")
	push("    local cfv = env.cframes and env.cframes[part]")
	push("    if cfv then return cfv end")
	push("    local ok, fallback = pcall(function() return part.CFrame end)")
	push("    if ok then return fallback end")
	push("    return nil")
	push("  end")
	push("  return env")
	push("end")
	push("")
	push("local function addInstance(self, inst)")
	push("  self.instances[#self.instances + 1] = inst")
	push("  return inst")
	push("end")
	push("")
	push("local function makeHost(self, name)")
	push("  local p = Instance.new('Part')")
	push("  p.Name = name")
	push("  p.Anchored = true")
	push("  p.CanCollide = false")
	push("  p.CanQuery = false")
	push("  p.CanTouch = false")
	push("  p.CastShadow = false")
	push("  p.Transparency = 1")
	push("  p.Massless = true")
	push("  p.Size = Vector3.new(0.1, 0.1, 0.1)")
	push("  p.Parent = self.env.ws")
	push("  return addInstance(self, p)")
	push("end")
	push("")
	push("local function spawnElement(self, el)")
	push("  local root, mesh")
	push("  if el.type == 'Part' then")
	push("    root = Instance.new('Part')")
	push("    root.Name = el.name:gsub('%s+', '_')")
	push("    root.Anchored = true")
	push("    root.CanCollide = false")
	push("    root.CanQuery = false")
	push("    root.CanTouch = false")
	push("    root.CastShadow = el.castShadow")
	push("    root.Color = rgb(el.color)")
	push("    root.Material = Enum.Material[el.material] or Enum.Material.Neon")
	push("    root.Transparency = el.transparency")
	push("    root.Shape = Enum.PartType[el.shape] or Enum.PartType.Ball")
	push("    root.Size = vec(el.size)")
	push("    root.Parent = self.env.ws")
	push("    addInstance(self, root)")
	push("  elseif el.type == 'SpecialMesh' then")
	push("    root = Instance.new('Part')")
	push("    root.Name = el.name:gsub('%s+', '_')")
	push("    root.Anchored = true")
	push("    root.CanCollide = false")
	push("    root.CanQuery = false")
	push("    root.CanTouch = false")
	push("    root.CastShadow = false")
	push("    root.Color = rgb(el.color)")
	push("    root.Material = Enum.Material[el.material] or Enum.Material.Neon")
	push("    root.Transparency = el.transparency")
	push("    root.Size = Vector3.new(2, 2, 2)")
	push("    mesh = Instance.new('SpecialMesh', root)")
	push("    mesh.MeshType = Enum.MeshType[el.meshType] or Enum.MeshType.Sphere")
	push("    mesh.Scale = vec(el.meshScale)")
	push("    if el.meshId ~= '' then mesh.MeshId = el.meshId end")
	push("    if el.textureId ~= '' then mesh.TextureId = el.textureId end")
	push("    root.Parent = self.env.ws")
	push("    addInstance(self, root)")
	push("  elseif el.type == 'Beam' then")
	push("    root = makeHost(self, 'VFX_BeamHost_' .. el.id)")
	push("    local a0 = Instance.new('Attachment', root)")
	push("    local a1 = Instance.new('Attachment', root)")
	push("    a1.Position = Vector3.new(0, 0, -el.beamLength)")
	push("    local bm = Instance.new('Beam', root)")
	push("    bm.Attachment0 = a0")
	push("    bm.Attachment1 = a1")
	push("    bm.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, rgb(el.color0)), ColorSequenceKeypoint.new(1, rgb(el.color1))})")
	push("    bm.Width0 = el.width0")
	push("    bm.Width1 = el.width1")
	push("    bm.Segments = el.segments")
	push("    bm.FaceCamera = el.faceCamera")
	push("    bm.LightInfluence = el.lightInfluence")
	push("  elseif el.type == 'Trail' then")
	push("    root = makeHost(self, 'VFX_TrailHost_' .. el.id)")
	push("    local a0 = Instance.new('Attachment', root)")
	push("    local a1 = Instance.new('Attachment', root)")
	push("    a1.Position = Vector3.new(0, el.trailWidth, 0)")
	push("    local tr = Instance.new('Trail', root)")
	push("    tr.Attachment0 = a0")
	push("    tr.Attachment1 = a1")
	push("    tr.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, rgb(el.color0)), ColorSequenceKeypoint.new(1, rgb(el.color1))})")
	push("    tr.Lifetime = el.trailLifetime")
	push("    tr.MinDistance = el.trailMinDist")
	push("  elseif el.type == 'ParticleEmitter' then")
	push("    root = makeHost(self, 'VFX_EmitHost_' .. el.id)")
	push("    local pe = Instance.new('ParticleEmitter', root)")
	push("    pe.Color = ColorSequence.new(rgb(el.peColor))")
	push("    pe.Rate = el.peRate")
	push("    pe.Speed = NumberRange.new(el.peSpeedMin, el.peSpeedMax)")
	push("    pe.Lifetime = NumberRange.new(el.peLifetimeMin, el.peLifetimeMax)")
	push("    pe.Size = NumberSequence.new(el.peSize)")
	push("    pe.SpreadAngle = Vector2.new(-el.peSpread, el.peSpread)")
	push("    pe.LockedToPart = el.peLockedToPart")
	push("  elseif el.type == 'BillboardGui' then")
	push("    root = makeHost(self, 'VFX_BBHost_' .. el.id)")
	push("    local bb = Instance.new('BillboardGui', root)")
	push("    bb.Size = UDim2.new(0, el.bbSizeX, 0, el.bbSizeY)")
	push("    bb.AlwaysOnTop = el.bbAlwaysOnTop")
	push("    bb.Adornee = root")
	push("    local label = Instance.new('TextLabel', bb)")
	push("    label.Size = UDim2.new(1, 0, 1, 0)")
	push("    label.BackgroundColor3 = rgb(el.bbBgColor)")
	push("    label.BackgroundTransparency = el.bbBgTrans")
	push("    label.TextColor3 = rgb(el.bbTextColor)")
	push("    label.Text = el.bbText")
	push("    label.TextScaled = true")
	push("    label.BorderSizePixel = 0")
	push("    Instance.new('UICorner', label).CornerRadius = UDim.new(0.3, 0)")
	push("  end")
	push("  if not root then return nil end")
	push("  return {data = el, root = root, mesh = mesh, sine = 0, infAngle = 0}")
	push("end")
	push("")
	push("function VFX.new(ctx)")
	push("  return setmetatable({env = makeEnv(ctx), instances = {}, elements = {}, active = false}, VFX)")
	push("end")
	push("")
	push("function VFX:spawn()")
	push("  self:destroy()")
	push("  self.active = true")
	push("  for _, el in ipairs(DATA) do")
	push("    if el.enabled then")
	push("      local state = spawnElement(self, el)")
	push("      if state then self.elements[#self.elements + 1] = state end")
	push("    end")
	push("  end")
	push("  return self")
	push("end")
	push("")
	push("function VFX:destroy()")
	push("  local env = self.env")
	push("  for _, inst in ipairs(self.instances) do")
	push("    if inst then")
	push("      pcall(function()")
	push("        for _, child in ipairs(inst:GetDescendants()) do")
	push("          if child:IsA('ParticleEmitter') then child.Enabled = false end")
	push("        end")
	push("      end)")
	push("      if inst.Parent then env.destroy(inst) end")
	push("    end")
	push("  end")
	push("  self.instances = {}")
	push("  self.elements = {}")
	push("  self.active = false")
	push("end")
	push("")
	push("function VFX:setActive(v)")
	push("  self.active = not not v")
	push("  return self")
	push("end")
	push("")
	push("function VFX:isActive()")
	push("  return self.active")
	push("end")
	push("")
	push("function VFX:update(dt)")
	push("  if not self.active then return end")
	push("  dt = dt or 0")
	push("  local env = self.env")
	push("  for _, state in ipairs(self.elements) do")
	push("    local el = state.data")
	push("    local root = state.root")
	push("    if root and root.Parent then")
	push("      local parentPart = env.getPart(el.parentPart)")
	push("      local baseCF = env.getBaseCFrame(parentPart, el.parentPart)")
	push("      if baseCF then")
	push("        state.sine = state.sine + dt")
	push("        local ox, oy, oz = el.offsetPos[1], el.offsetPos[2], el.offsetPos[3]")
	push("        if el.animPos then")
	push("          local pt = state.sine * el.animPosSpeed * (2 * math.pi)")
	push("          local ps = math.sin(pt)")
	push("          ox = ox + el.animPosAmp[1] * ps")
	push("          oy = oy + el.animPosAmp[2] * ps")
	push("          oz = oz + el.animPosAmp[3] * ps")
	push("        end")
	push("        local rx, ry, rz = env.rad(el.offsetRot[1]), env.rad(el.offsetRot[2]), env.rad(el.offsetRot[3])")
	push("        if el.animRot then")
	push("          local rt = state.sine * el.animRotSpeed * (2 * math.pi)")
	push("          local rs = math.sin(rt)")
	push("          rx = rx + env.rad(el.animRotAmp[1]) * rs")
	push("          ry = ry + env.rad(el.animRotAmp[2]) * rs")
	push("          rz = rz + env.rad(el.animRotAmp[3]) * rs")
	push("        end")
	push("        local target")
	push("        if el.type == 'BillboardGui' then")
	push("          target = env.cfMul(baseCF, env.cf(ox, oy + el.bbOffsetY, oz))")
	push("        else")
	push("          target = env.cfMul(env.cfMul(baseCF, env.cf(ox, oy, oz)), env.angles(rx, ry, rz))")
	push("          if el.infRot then")
	push("            state.infAngle = state.infAngle + env.rad(el.infRotSpeed) * dt")
	push("            local axis = vec(el.infRotAxis)")
	push("            local safeAxis = axis.Magnitude > 0 and axis.Unit or Vector3.new(0, 1, 0)")
	push("            target = env.cfMul(target, CFrame.fromAxisAngle(safeAxis, state.infAngle))")
	push("          end")
	push("        end")
	push("        local alpha = math.min(1, 0.15 * 60 * dt + 0.3)")
	push("        root.CFrame = root.CFrame:Lerp(target, alpha)")
	push("        if el.animScale then")
	push("          local scale = math.max(0.01, 1 + el.animScaleAmp * math.sin(state.sine * el.animScaleSpeed * 2 * math.pi))")
	push("          if el.type == 'Part' then")
	push("            root.Size = Vector3.new(el.size[1] * scale, el.size[2] * scale, el.size[3] * scale)")
	push("          elseif el.type == 'SpecialMesh' and state.mesh then")
	push("            state.mesh.Scale = Vector3.new(el.meshScale[1] * scale, el.meshScale[2] * scale, el.meshScale[3] * scale)")
	push("          end")
	push("        end")
	push("      end")
	push("    end")
	push("  end")
	push("end")
	push("")
	push("function VFX:connect(signal, connectFn)")
	push("  connectFn = connectFn or function(sig, fn) return sig:Connect(fn) end")
	push("  self.connection = connectFn(signal, function(dt) self:update(dt) end)")
	push("  return self.connection")
	push("end")
	push("")
	push("function VFX:disconnect()")
	push("  if self.connection then")
	push("    self.connection:Disconnect()")
	push("    self.connection = nil")
	push("  end")
	push("end")
	push("")
	push("return VFX")
	return table.concat(L, "\n")
end

-- Drop-in export for the reanimate() return-table workflow.
-- The older generateCode body above is kept for reference, but this is what Export uses.
generateCode = function()
	local L = {}
	local function push(s) L[#L+1] = s end

	local ident = fmtIdent(exportFunctionName)
	local dataName = ident .. "Data"
	local activeName = ident .. "Active"
	local partsName = ident .. "Parts"
	local spawnName = ident
	local destroyName = ident .. "end"
	local updateName = "update" .. ident

	push("-- VFX Animator reanimate() drop-in export")
	push("-- Paste this inside reanimate(), above the return { ... } table.")
	push("-- Call spawn once; call clear when you want to remove the VFX.")
	push("")
	push(fmt("local %s, %s, %s", spawnName, destroyName, updateName))
	push("do")
	push("-- (scoped in do...end so the module helpers/state do not use up reanimate()'s 200 local slots)")
	push(fmt("local %s = false", activeName))

	push(fmt("local %s = nil", partsName))
	push("")
	push(fmt("local %s = {", dataName))

	for _, el in ipairs(vfxList) do
		push("    {")
		push(fmt("        id=%d, type=%s, name=%s, parentPart=%s, enabled=%s,",
			el.id, fmtS(el.type), fmtS(el.name), fmtS(el.parentPart), tostring(el.enabled ~= false)))
		push(fmt("        color=%s, material=%s, transparency=%s, castShadow=%s, shape=%s, size=%s,",
			fmtArr(el.color), fmtS(el.material), fmtN(el.transparency), tostring(el.castShadow == true), fmtS(el.shape), fmtArr(el.size)))
		push(fmt("        meshType=%s, meshId=%s, textureId=%s, meshScale=%s,",
			fmtS(el.meshType), fmtS(el.meshId), fmtS(el.textureId), fmtArr(el.meshScale)))
		push(fmt("        offsetPos=%s, offsetRot=%s, spawnAtGround=%s, groundOffset=%s,",
			fmtArr(el.offsetPos), fmtArr(el.offsetRot), tostring(el.spawnAtGround == true), fmtN(el.groundOffset)))
		push(fmt("        animPos=%s, animPosAmp=%s, animPosSpeed=%s,",
			tostring(el.animPos == true), fmtArr(el.animPosAmp), fmtN(el.animPosSpeed)))
		push(fmt("        animRot=%s, animRotAmp=%s, animRotSpeed=%s,",
			tostring(el.animRot == true), fmtArr(el.animRotAmp), fmtN(el.animRotSpeed)))
		push(fmt("        infRot=%s, infRotAxis=%s, infRotSpeed=%s,",
			tostring(el.infRot == true), fmtArr(el.infRotAxis), fmtN(el.infRotSpeed)))
		push(fmt("        animScale=%s, animScaleAmp=%s, animScaleSpeed=%s,",
			tostring(el.animScale == true), fmtN(el.animScaleAmp), fmtN(el.animScaleSpeed)))
		push(fmt("        color0=%s, color1=%s, width0=%s, width1=%s, beamLength=%s, segments=%d, faceCamera=%s, lightInfluence=%s,",
			fmtArr(el.color0), fmtArr(el.color1), fmtN(el.width0), fmtN(el.width1), fmtN(el.beamLength), math.round(el.segments), tostring(el.faceCamera == true), fmtN(el.lightInfluence)))
		push(fmt("        trailLifetime=%s, trailWidth=%s, trailMinDist=%s,",
			fmtN(el.trailLifetime), fmtN(el.trailWidth), fmtN(el.trailMinDist)))
		push(fmt("        peColor=%s, peRate=%s, peSpeedMin=%s, peSpeedMax=%s, peLifetimeMin=%s, peLifetimeMax=%s, peSize=%s, peSpread=%s, peTexture=%s, peOrientation=%s, peRotationMin=%s, peRotationMax=%s, peRotSpeedMin=%s, peRotSpeedMax=%s,",
			fmtArr(el.peColor), fmtN(particleRate(el)), fmtN(el.peSpeedMin), fmtN(el.peSpeedMax), fmtN(el.peLifetimeMin), fmtN(el.peLifetimeMax), fmtN(el.peSize), fmtN(el.peSpread), fmtS(el.peTexture), fmtS(el.peOrientation), fmtN(el.peRotationMin), fmtN(el.peRotationMax), fmtN(el.peRotSpeedMin), fmtN(el.peRotSpeedMax)))
		push(fmt("        peLockedToPart=%s, peTransparency=%s, peSquash=%s, peLightEmission=%s, peLightInfluence=%s, peBrightness=%s,",
			tostring(el.peLockedToPart == true), fmtN(el.peTransparency or 0), fmtN(el.peSquash or 0), fmtN(el.peLightEmission or 0), fmtN(el.peLightInfluence or 0), fmtN(el.peBrightness or 1)))
		push(fmt("        peDrag=%s, peZOffset=%s, peTimeScale=%s, peVelocityInheritance=%s, peAccel=%s, peEmissionDirection=%s,",
			fmtN(el.peDrag or 0), fmtN(el.peZOffset or 0), fmtN(el.peTimeScale or 1), fmtN(el.peVelocityInheritance or 0), fmtArr(el.peAccel or {0,0,0}), fmtS(el.peEmissionDirection or "Top")))
		push(fmt("        peShape=%s, peShapeStyle=%s, peShapeInOut=%s, peShapePartial=%s, peFlipbookLayout=%s, peFlipbookMode=%s, peFlipbookFramerate=%s, peFlipbookStartRandom=%s,",
			fmtS(el.peShape or "Box"), fmtS(el.peShapeStyle or "Volume"), fmtS(el.peShapeInOut or "Outward"), fmtN(el.peShapePartial or 1), fmtS(el.peFlipbookLayout or "None"), fmtS(el.peFlipbookMode or "Loop"), fmtN(el.peFlipbookFramerate or 15), tostring(el.peFlipbookStartRandom == true)))
		if el.peSizeCurve   then push("        peSizeSeq=" .. PE.fmtCurve(el.peSizeCurve) .. ",") end
		if el.peTransCurve  then push("        peTransSeq=" .. PE.fmtCurve(el.peTransCurve) .. ",") end
		if el.peSquashCurve then push("        peSquashSeq=" .. PE.fmtCurve(el.peSquashCurve) .. ",") end
		if el.peColorCurve  then push("        peColorSeq=" .. PE.fmtCurve(el.peColorCurve, true) .. ",") end

		push(fmt("        bbText=%s, bbTextColor=%s, bbBgColor=%s, bbBgTrans=%s, bbSizeX=%d, bbSizeY=%d, bbOffsetY=%s, bbAlwaysOnTop=%s,",
			fmtS(el.bbText), fmtArr(el.bbTextColor), fmtArr(el.bbBgColor), fmtN(el.bbBgTrans), math.round(el.bbSizeX), math.round(el.bbSizeY), fmtN(el.bbOffsetY), tostring(el.bbAlwaysOnTop == true)))
		push("    },")
	end

	push("}")
	push("")
	push("local vfxPlayers = game:GetService(\"Players\")")
	push("local vfxWorkspace = ws or workspace")
	push("local vfxCF = cf or CFrame.new")
	push("local vfxCFMul = cfMul or function(a, b) return a * b end")
	push("local vfxAngles = angles or CFrame.Angles")
	push("local vfxRad = rad or math.rad")
	push("local vfxSin = sin or math.sin")
	push("local vfxHeartbeat = heartbeat or game:GetService(\"RunService\").Heartbeat")
	push("local vfxConnect = type(Connect) == \"function\" and Connect or function(signal, callback) return signal:Connect(callback) end")
	push("local vfxCons = type(cons) == \"table\" and cons or {}")
	push("local function vfxGetCharacter()")
	push("    return c or (vfxPlayers.LocalPlayer and vfxPlayers.LocalPlayer.Character)")
	push("end")
	push("local function vfxGetPart(name)")
	push("    if type(getPart) == \"function\" then")
	push("        local ok, part = pcall(getPart, name)")
	push("        if ok and part then return part end")
	push("    end")
	push("    local character = vfxGetCharacter()")
	push("    return character and (character:FindFirstChild(name) or character:FindFirstChild(name, true))")
	push("end")
	push("")
	push("local function vfxColor(t)")
	push("    return Color3.fromRGB(math.round(t[1] or 0), math.round(t[2] or 0), math.round(t[3] or 0))")
	push("end")
	push("")
	push("local function vfxVector(t)")
	push("    return Vector3.new(t[1] or 0, t[2] or 0, t[3] or 0)")
	push("end")
	push("")
	push("local function vfxAsset(value)")
	push("    local text = tostring(value or \"\"):gsub(\"%s+\", \"\")")
	push("    if text:match(\"^%d+$\") then return \"rbxassetid://\" .. text end")
	push("    return text")
	push("end")
	push("")
	push('local function vfxSortSeq(seq)')
	push('    local s = {}')
	push('    for i, p in ipairs(seq) do s[i] = p end')
	push('    table.sort(s, function(a, b) return a[1] < b[1] end)')
	push('    s[1] = {0, s[1][2], s[1][3], s[1][4]}')
	push('    s[#s] = {1, s[#s][2], s[#s][3], s[#s][4]}')
	push('    for i = 2, #s do')
	push('        if s[i][1] <= s[i - 1][1] then s[i] = {math.min(1, s[i - 1][1] + 0.001), s[i][2], s[i][3], s[i][4]} end')
	push('    end')
	push('    return s')
	push('end')
	push('')
	push('local function vfxNumSeq(seq, flat)')
	push('    if not seq or #seq < 2 then return NumberSequence.new(flat) end')
	push('    local k = {}')
	push('    for i, p in ipairs(vfxSortSeq(seq)) do k[i] = NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0) end')
	push('    return NumberSequence.new(k)')
	push('end')
	push('')
	push('local function vfxColSeq(seq, rgb)')
	push('    if not seq or #seq < 2 then return ColorSequence.new(vfxColor(rgb)) end')
	push('    local k = {}')
	push('    for i, p in ipairs(vfxSortSeq(seq)) do k[i] = ColorSequenceKeypoint.new(p[1], vfxColor({p[2], p[3], p[4]})) end')
	push('    return ColorSequence.new(k)')
	push('end')
	push('')
	push('local function vfxApplyPE(pe, el)')
	push('    pe.Color = vfxColSeq(el.peColorSeq, el.peColor)')
	push('    pe.Size = vfxNumSeq(el.peSizeSeq, el.peSize)')
	push('    pe.Transparency = vfxNumSeq(el.peTransSeq, el.peTransparency or 0)')
	push('    pe.Squash = vfxNumSeq(el.peSquashSeq, el.peSquash or 0)')
	push('    pe.Rate = el.peRate')
	push('    pe.Speed = NumberRange.new(math.min(el.peSpeedMin, el.peSpeedMax), math.max(el.peSpeedMin, el.peSpeedMax))')
	push('    pe.Lifetime = NumberRange.new(math.min(el.peLifetimeMin, el.peLifetimeMax), math.max(el.peLifetimeMin, el.peLifetimeMax))')
	push('    pe.SpreadAngle = Vector2.new(-el.peSpread, el.peSpread)')
	push('    pe.LockedToPart = el.peLockedToPart == true')
	push('    pe.Orientation = Enum.ParticleOrientation[el.peOrientation] or Enum.ParticleOrientation.FacingCamera')
	push('    pe.Rotation = NumberRange.new(math.min(el.peRotationMin, el.peRotationMax), math.max(el.peRotationMin, el.peRotationMax))')
	push('    pe.RotSpeed = NumberRange.new(math.min(el.peRotSpeedMin, el.peRotSpeedMax), math.max(el.peRotSpeedMin, el.peRotSpeedMax))')
	push('    pe.Texture = vfxAsset(el.peTexture)')
	push('    pe.LightEmission = el.peLightEmission or 0')
	push('    pe.LightInfluence = el.peLightInfluence or 0')
	push('    pe.Brightness = el.peBrightness or 1')
	push('    pe.Drag = el.peDrag or 0')
	push('    pe.ZOffset = el.peZOffset or 0')
	push('    pe.TimeScale = el.peTimeScale or 1')
	push('    pe.VelocityInheritance = el.peVelocityInheritance or 0')
	push('    local a = el.peAccel or {0, 0, 0}')
	push('    pe.Acceleration = Vector3.new(a[1], a[2], a[3])')
	push('    pe.EmissionDirection = Enum.NormalId[el.peEmissionDirection or "Top"] or Enum.NormalId.Top')
	push('    pcall(function()')
	push('        pe.Shape = Enum.ParticleEmitterShape[el.peShape or "Box"]')
	push('        pe.ShapeStyle = Enum.ParticleEmitterShapeStyle[el.peShapeStyle or "Volume"]')
	push('        pe.ShapeInOut = Enum.ParticleEmitterShapeInOut[el.peShapeInOut or "Outward"]')
	push('        pe.ShapePartial = el.peShapePartial or 1')
	push('    end)')
	push('    pcall(function()')
	push('        pe.FlipbookLayout = Enum.ParticleFlipbookLayout[el.peFlipbookLayout or "None"]')
	push('        pe.FlipbookMode = Enum.ParticleFlipbookMode[el.peFlipbookMode or "Loop"]')
	push('        pe.FlipbookFramerate = NumberRange.new(el.peFlipbookFramerate or 15)')
	push('        pe.FlipbookStartRandom = el.peFlipbookStartRandom == true')
	push('    end)')
	push('end')
	push('')

	push("local vfxRayParams = RaycastParams.new()")
	push("vfxRayParams.FilterType = Enum.RaycastFilterType.Exclude")
	push("vfxRayParams.IgnoreWater = true")
	push("vfxRayParams.RespectCanCollide = true")
	push("")
	push("local function vfxGroundOrigin(pack, baseCF, lift)")
	push("    local pos = baseCF.Position")
	push("    local filter = {}")
	push("    local character = vfxGetCharacter()")
	push("    if character then filter[#filter + 1] = character end")
	push("    if pack and pack.instances then")
	push("        for _, inst in ipairs(pack.instances) do")
	push("            if inst then filter[#filter + 1] = inst end")
	push("        end")
	push("    end")
	push("    local vfxFolder = vfxWorkspace:FindFirstChild('VFX')")
	push("    if vfxFolder then filter[#filter + 1] = vfxFolder end")
	push("    local reanimateFolder = vfxWorkspace:FindFirstChild('Reanimate')")
	push("    if reanimateFolder then filter[#filter + 1] = reanimateFolder end")
	push("    vfxRayParams.FilterDescendantsInstances = filter")
	push("    local hit = vfxWorkspace:Raycast(pos + Vector3.new(0, 80, 0), Vector3.new(0, -600, 0), vfxRayParams)")
	push("    if not hit then return baseCF end")
	push("    return CFrame.new(pos.X, hit.Position.Y + (lift or 0.5), pos.Z) * (baseCF - baseCF.Position)")
	push("end")
	push("")
	push("local function vfxAdd(pack, inst)")
	push("    pack.instances[#pack.instances + 1] = inst")
	push("    return inst")
	push("end")
	push("")
	push("local function vfxHost(pack, name)")
	push("    local p = Instance.new(\"Part\")")
	push("    p.Name = name")
	push("    p.Anchored = true")
	push("    p.CanCollide = false")
	push("    p.CanQuery = false")
	push("    p.CanTouch = false")
	push("    p.CastShadow = false")
	push("    p.Transparency = 1")
	push("    p.Massless = true")
	push("    p.Size = Vector3.new(0.1, 0.1, 0.1)")
	push("    p.Parent = vfxWorkspace")
	push("    return vfxAdd(pack, p)")
	push("end")
	push("")
	push("local function vfxSpawnElement(pack, el)")
	push("    local root, mesh")
	push("    if el.type == \"Part\" then")
	push("        root = Instance.new(\"Part\")")
	push("        root.Name = el.name:gsub(\"%s+\", \"_\")")
	push("        root.Anchored = true")
	push("        root.CanCollide = false")
	push("        root.CanQuery = false")
	push("        root.CanTouch = false")
	push("        root.CastShadow = el.castShadow")
	push("        root.Color = vfxColor(el.color)")
	push("        root.Material = Enum.Material[el.material] or Enum.Material.Neon")
	push("        root.Transparency = el.transparency")
	push("        root.Shape = Enum.PartType[el.shape] or Enum.PartType.Ball")
	push("        root.Size = vfxVector(el.size)")
	push("        root.Parent = vfxWorkspace")
	push("        vfxAdd(pack, root)")
	push("    elseif el.type == \"SpecialMesh\" then")
	push("        root = Instance.new(\"Part\")")
	push("        root.Name = el.name:gsub(\"%s+\", \"_\")")
	push("        root.Anchored = true")
	push("        root.CanCollide = false")
	push("        root.CanQuery = false")
	push("        root.CanTouch = false")
	push("        root.CastShadow = false")
	push("        root.Color = vfxColor(el.color)")
	push("        root.Material = Enum.Material[el.material] or Enum.Material.Neon")
	push("        root.Transparency = el.transparency")
	push("        root.Size = Vector3.new(2, 2, 2)")
	push("        mesh = Instance.new(\"SpecialMesh\", root)")
	push("        mesh.MeshType = Enum.MeshType[el.meshType] or Enum.MeshType.Sphere")
	push("        mesh.Scale = vfxVector(el.meshScale)")
	push("        if el.meshId ~= \"\" then mesh.MeshId = vfxAsset(el.meshId) end")
	push("        if el.textureId ~= \"\" then mesh.TextureId = vfxAsset(el.textureId) end")
	push("        root.Parent = vfxWorkspace")
	push("        vfxAdd(pack, root)")
	push("    elseif el.type == \"Beam\" then")
	push("        root = vfxHost(pack, \"VFX_BeamHost_\" .. el.id)")
	push("        local a0 = Instance.new(\"Attachment\", root)")
	push("        local a1 = Instance.new(\"Attachment\", root)")
	push("        a1.Position = Vector3.new(0, 0, -el.beamLength)")
	push("        local beam = Instance.new(\"Beam\", root)")
	push("        beam.Attachment0 = a0")
	push("        beam.Attachment1 = a1")
	push("        beam.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, vfxColor(el.color0)), ColorSequenceKeypoint.new(1, vfxColor(el.color1))})")
	push("        beam.Width0 = el.width0")
	push("        beam.Width1 = el.width1")
	push("        beam.Segments = el.segments")
	push("        beam.FaceCamera = el.faceCamera")
	push("        beam.LightInfluence = el.lightInfluence")
	push("    elseif el.type == \"Trail\" then")
	push("        root = vfxHost(pack, \"VFX_TrailHost_\" .. el.id)")
	push("        local a0 = Instance.new(\"Attachment\", root)")
	push("        local a1 = Instance.new(\"Attachment\", root)")
	push("        a1.Position = Vector3.new(0, el.trailWidth, 0)")
	push("        local trail = Instance.new(\"Trail\", root)")
	push("        trail.Attachment0 = a0")
	push("        trail.Attachment1 = a1")
	push("        trail.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, vfxColor(el.color0)), ColorSequenceKeypoint.new(1, vfxColor(el.color1))})")
	push("        trail.Lifetime = el.trailLifetime")
	push("        trail.MinDistance = el.trailMinDist")
	push("    elseif el.type == \"ParticleEmitter\" then")
	push("        root = vfxHost(pack, \"VFX_EmitHost_\" .. el.id)")
	push("        local pe = Instance.new(\"ParticleEmitter\", root)")
	push("        pe.Enabled = false")
	push("        vfxApplyPE(pe, el)")
	push("    elseif el.type == \"BillboardGui\" then")
	push("        root = vfxHost(pack, \"VFX_BBHost_\" .. el.id)")
	push("        local bb = Instance.new(\"BillboardGui\", root)")
	push("        bb.Size = UDim2.new(0, el.bbSizeX, 0, el.bbSizeY)")
	push("        bb.AlwaysOnTop = el.bbAlwaysOnTop")
	push("        bb.Adornee = root")
	push("        local label = Instance.new(\"TextLabel\", bb)")
	push("        label.Size = UDim2.new(1, 0, 1, 0)")
	push("        label.BackgroundColor3 = vfxColor(el.bbBgColor)")
	push("        label.BackgroundTransparency = el.bbBgTrans")
	push("        label.TextColor3 = vfxColor(el.bbTextColor)")
	push("        label.Text = el.bbText")
	push("        label.TextScaled = true")
	push("        label.BorderSizePixel = 0")
	push("        Instance.new(\"UICorner\", label).CornerRadius = UDim.new(0.3, 0)")
	push("    end")
	push("    if not root then return nil end")
	push("    return {data = el, root = root, mesh = mesh, sine = 0, infAngle = 0, positioned = false}")
	push("end")
	push("")
	push(fmt("function %s()", destroyName))
	push(fmt("    if %s then", partsName))
	push(fmt("        for _, inst in ipairs(%s.instances) do", partsName))
	push("            if inst and inst.Parent then")
	push("                for _, child in ipairs(inst:GetDescendants()) do")
	push("                    if child:IsA(\"ParticleEmitter\") then child.Enabled = false end")
	push("                end")
	push("                inst:Destroy()")
	push("            end")
	push("        end")
	push("    end")
	push(fmt("    %s = nil", partsName))
	push(fmt("    %s = false", activeName))
	push("end")
	push("")
	push(fmt("function %s()", spawnName))
	push(fmt("    if %s then", partsName))
	push(fmt("        %s = true", activeName))
	push(fmt("        return %s", partsName))
	push("    end")
	push("    local pack = {instances = {}, elements = {}}")
	push(fmt("    for _, el in ipairs(%s) do", dataName))
	push("        if el.enabled then")
	push("            local state = vfxSpawnElement(pack, el)")
	push("            if state then pack.elements[#pack.elements + 1] = state end")
	push("        end")
	push("    end")
	push(fmt("    %s = pack", partsName))
	push(fmt("    %s = true", activeName))
	push("    return pack")
	push("end")
	push("")
	push(fmt("function %s(dt)", updateName))
	push(fmt("    if not %s or not %s then return end", activeName, partsName))
	push("    dt = dt or deltaTime or 0")
	push(fmt("    for _, state in ipairs(%s.elements) do", partsName))
	push("        local el = state.data")
	push("        local root = state.root")
	push("        if root and root.Parent then")
	push("            local parentPart = vfxGetPart(el.parentPart)")
	push("            local mappedCF = parentPart and cframes and (cframes[parentPart] or cframes[el.parentPart])")
	push("            local baseCF = parentPart and (mappedCF or parentPart.CFrame)")
	push("            if baseCF then")
	push("                if el.spawnAtGround then baseCF = vfxGroundOrigin(" .. partsName .. ", baseCF, el.groundOffset) end")
	push("                state.sine = state.sine + dt")
	push("                local ox, oy, oz = el.offsetPos[1], el.offsetPos[2], el.offsetPos[3]")
	push("                if el.animPos then")
	push("                    local pt = state.sine * el.animPosSpeed * (2 * math.pi)")
	push("                    local ps = vfxSin(pt)")
	push("                    ox = ox + el.animPosAmp[1] * ps")
	push("                    oy = oy + el.animPosAmp[2] * ps")
	push("                    oz = oz + el.animPosAmp[3] * ps")
	push("                end")
	push("                local rx = vfxRad(el.offsetRot[1])")
	push("                local ry = vfxRad(el.offsetRot[2])")
	push("                local rz = vfxRad(el.offsetRot[3])")
	push("                if el.animRot then")
	push("                    local rt = state.sine * el.animRotSpeed * (2 * math.pi)")
	push("                    local rs = vfxSin(rt)")
	push("                    rx = rx + vfxRad(el.animRotAmp[1]) * rs")
	push("                    ry = ry + vfxRad(el.animRotAmp[2]) * rs")
	push("                    rz = rz + vfxRad(el.animRotAmp[3]) * rs")
	push("                end")
	push("                local target")
	push("                if el.type == \"BillboardGui\" then")
	push("                    target = vfxCFMul(baseCF, vfxCF(ox, oy + el.bbOffsetY, oz))")
	push("                else")
	push("                    target = vfxCFMul(vfxCFMul(baseCF, vfxCF(ox, oy, oz)), vfxAngles(rx, ry, rz))")
	push("                    if el.infRot then")
	push("                        state.infAngle = state.infAngle + vfxRad(el.infRotSpeed) * dt")
	push("                        local axis = vfxVector(el.infRotAxis)")
	push("                        local safeAxis = axis.Magnitude > 0 and axis.Unit or Vector3.new(0, 1, 0)")
	push("                        target = vfxCFMul(target, CFrame.fromAxisAngle(safeAxis, state.infAngle))")
	push("                    end")
	push("                end")
	push("                local alpha = math.min(1, 0.15 * 60 * dt + 0.3)")
	push("                if state.positioned then")
	push("                    root.CFrame = root.CFrame:Lerp(target, alpha)")
	push("                else")
	push("                    root.CFrame = target")
	push("                end")
	push("                if not state.positioned then")
	push("                    state.positioned = true")
	push("                    if el.type == \"ParticleEmitter\" then")
	push("                        local emitter = root:FindFirstChildOfClass(\"ParticleEmitter\")")
	push("                        if emitter then emitter.Enabled = true end")
	push("                    end")
	push("                end")
	push("                if el.animScale then")
	push("                    local scale = math.max(0.01, 1 + el.animScaleAmp * vfxSin(state.sine * el.animScaleSpeed * 2 * math.pi))")
	push("                    if el.type == \"Part\" then")
	push("                        root.Size = Vector3.new(el.size[1] * scale, el.size[2] * scale, el.size[3] * scale)")
	push("                    elseif el.type == \"SpecialMesh\" and state.mesh then")
	push("                        state.mesh.Scale = Vector3.new(el.meshScale[1] * scale, el.meshScale[2] * scale, el.meshScale[3] * scale)")
	push("                    end")
	push("                end")
	push("            end")
	push("        end")
	push("    end")
	push("end")
	push("")
	if exportAutoConnect then
		push(fmt("table.insert(vfxCons, vfxConnect(vfxHeartbeat, %s))", updateName))
		push("")
	end
	push("end")
	push("")
	push(fmt("-- Call %s(dt) every frame from your reanimate loop.", updateName))

	push("-- Add only these entries inside your reanimate() return table:")
	push(fmt("-- %s = %s,", spawnName, spawnName))
	push(fmt("-- %s = %s,", destroyName, destroyName))

	return table.concat(L, "\n")
end
-- ═══════════════════════════════════════════════════════════════════════
--  SCREEN SCALING
-- ═══════════════════════════════════════════════════════════════════════
local BASE_W, BASE_H = 1920, 1080
local function calcScale()
	local vp = Camera.ViewportSize
	return math.min(vp.X / BASE_W, vp.Y / BASE_H)
end
local S = calcScale()
local function px(n)  return math.max(1, math.round(n * S)) end
local function ud(s,o) return UDim.new(s, px(o)) end
local FS = { tiny = math.max(8, px(10)), sm = math.max(9, px(11)), md = math.max(10, px(13)) }

-- ═══════════════════════════════════════════════════════════════════════
--  GUI SETUP
-- ═══════════════════════════════════════════════════════════════════════
local old = CoreGui:FindFirstChild("VFXAnimatorGUI")
if old then old:Destroy() end

local SG = Instance.new("ScreenGui")
SG.Name            = "VFXAnimatorGUI"
SG.ResetOnSpawn    = false
SG.ZIndexBehavior = Enum.ZIndexBehavior.Global
SG.IgnoreGuiInset  = true
SG.DisplayOrder    = 999
if not pcall(function() SG.Parent = CoreGui end) then
	SG.Parent = lp.PlayerGui
end

local C = {
  bg       = c3r(13,13,15),    panel   = c3r(22,22,24),
  elevated = c3r(30,30,32),    border  = c3r(58,58,60),
  accent   = c3r(95, 8, 255),  accent2 = c3r(128, 63, 212),
  warn     = c3r(255,159,10),  red     = c3r(255,69,58),
  green    = c3r(48,209,88),   text    = c3r(242,242,247),
  muted    = c3r(142,142,147), white   = c3r(255,255,255),
  code     = c3r(100,210,255), revOn   = c3r(255,159,10),
  axisX    = c3r(255,69,58),   axisY   = c3r(48,209,88),  axisZ = c3r(10,132,255),
  sub      = c3r(28,28,30),
}

local WIN_W   = px(560); local WIN_H   = px(720)
local TITLE_H = px(34);  local TOOL_H  = px(32)
local CODE_H  = px(90)
local SCROLL_H = WIN_H - TITLE_H - TOOL_H - px(4) - CODE_H - px(2)
local vp = Camera.ViewportSize
local WX = math.round(vp.X * 0.03)
local WY = math.round(vp.Y * 0.03)

-- --- GUI helpers ---------------------------------------------------------------------------------
local function make(cls, props, parent)
	local inst = Instance.new(cls)
	for k, v in pairs(props) do inst[k] = v end
	if parent then inst.Parent = parent end
	return inst
end
local function frm(props, par)
	props.BackgroundColor3 = props.BackgroundColor3 or C.panel
	props.BorderSizePixel  = props.BorderSizePixel  or 0
	return make("Frame", props, par)
end
local function lbl(props, par)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3             = props.TextColor3 or C.text
	props.Font                   = props.Font       or Enum.Font.Gotham
	props.TextSize               = props.TextSize   or FS.sm
	return make("TextLabel", props, par)
end
local function btn(props, par)
	props.BackgroundColor3 = props.BackgroundColor3 or C.elevated
	props.BorderSizePixel  = 0
	props.Font             = props.Font or Enum.Font.GothamBold
	props.TextSize         = props.TextSize or FS.tiny
	props.TextColor3       = props.TextColor3 or C.text
	props.AutoButtonColor  = false
	if props.Size then
		local sx, sy = props.Size.X, props.Size.Y
		local minX, minY = px(24), px(22)
		local nx = (sx.Scale == 0 and sx.Offset >= 0 and sx.Offset < minX) and minX or sx.Offset
		local ny = (sy.Scale == 0 and sy.Offset >= 0 and sy.Offset < minY) and minY or sy.Offset
		local growY = ny - sy.Offset
		props.Size = UDim2.new(sx.Scale, nx, sy.Scale, ny)
		if growY > 0 and props.Position and props.Position.Y.Scale == 0.5 then
			local pxp, pyp = props.Position.X, props.Position.Y
			props.Position = UDim2.new(pxp.Scale, pxp.Offset, pyp.Scale, pyp.Offset - math.floor(growY / 2))
		end
	end
	local b = make("TextButton", props, par)
	local orig = props.BackgroundColor3
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = Color3.new(
			math.min(1, orig.R + 0.08), math.min(1, orig.G + 0.08), math.min(1, orig.B + 0.08)
		)}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = orig}):Play()
	end)
	return b
end
local function crn(r, par)  return make("UICorner",   {CornerRadius = ud(0, r)}, par) end
local function pad(t,b,l,r,par)
	return make("UIPadding", {
		PaddingTop    = ud(0,t), PaddingBottom = ud(0,b),
		PaddingLeft   = ud(0,l), PaddingRight  = ud(0,r)
	}, par)
end
local function strk(col,th,par) return make("UIStroke", {Color=col, Thickness=th}, par) end
local function listL(dir, gap, va, par)
	return make("UIListLayout", {
		FillDirection    = dir or Enum.FillDirection.Vertical,
		Padding          = ud(0, gap or 3),
		VerticalAlignment= va or Enum.VerticalAlignment.Top,
		SortOrder        = Enum.SortOrder.LayoutOrder,
	}, par)
end

